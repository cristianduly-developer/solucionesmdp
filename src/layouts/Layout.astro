---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  navType?: 'landing' | 'app';
}

const {
  title,
  description = "Apps para negocios argentinos. Sin instalación, sin papeles, desde el celular.",
  ogImage = "/og-image.svg",
  navType = 'landing',
} = Astro.props;

const siteUrl = "https://www.solucionesmdp.com.ar";
const fullTitle = title === "Inicio"
  ? "Soluciones MDP — Apps para negocios argentinos"
  : `${title} | Soluciones MDP`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Soluciones MDP" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="site-nav">
      <a href="/" style="display:flex;align-items:center;">
        <img src="/logo.png" alt="Soluciones MDP" style="height:22px;" />
      </a>

      {navType === 'landing' ? (
        <div class="nav-links">
          <a href="#apps">Apps</a>
          <a href="#como-funciona">Cómo funciona</a>
          <a href="#opiniones">Opiniones</a>
          <a href="#faq">FAQ</a>
        </div>
      ) : (
        <a href="/" class="nav-back">← Todas las apps</a>
      )}

      <a href="https://wa.me/542235767784" target="_blank" class="nav-cta">
        Consultar por WhatsApp
      </a>
    </nav>

    <main style="padding-top:64px;">
      <slot />
    </main>

    <footer style="padding:36px 48px; background:#09090f; border-top:1px solid oklch(14% 0.04 270); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;">
      <div style="display:flex; align-items:center; gap:20px;">
        <img src="/logo.png" alt="Soluciones MDP" style="height:20px; opacity:0.6;" />
        <span style="font-size:13px; color:oklch(36% 0.04 270);">© 2025 Soluciones MDP · Mar del Plata, Argentina</span>
      </div>
      <a href="https://wa.me/542235767784" target="_blank" class="footer-wa"
        style="font-size:13px; color:oklch(46% 0.04 270); transition:color 0.2s;">
        Contacto por WhatsApp
      </a>
    </footer>
  </body>
</html>

<style>
  .footer-wa:hover { color: #22c55e; }
</style>
