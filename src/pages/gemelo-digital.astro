---
import Layout from '../layouts/Layout.astro';

const APP_URLS: Record<string, string> = {
  gastro: 'https://gastronomia.solucionesmdp.com.ar',
  turnos: 'https://turnos.solucionesmdp.com.ar',
  quincho: 'https://quincho-bere.vercel.app',
  membresias: 'https://socioapp.solucionesmdp.com.ar',
  reparto: 'https://reparto.solucionesmdp.com.ar',
  presup: 'https://presup.solucionesmdp.com.ar',
  contratista: 'https://contratista.solucionesmdp.com.ar',
  docentes: 'https://docentes.solucionesmdp.com.ar',
};

const APP_NAMES: Record<string, string> = {
  gastro: 'App Gastronomía',
  turnos: 'App Turnos',
  quincho: 'App Eventos',
  membresias: 'App Membresías',
  reparto: 'App Reparto',
  presup: 'App Presupuestos',
  contratista: 'App Contratista',
  docentes: 'App Docentes',
};
---
<Layout
  title="Gemelo Digital Gratis"
  description="Creamos el gemelo digital de tu negocio gratis en 30 segundos. Descubrí qué le falta a tu presencia digital y recibí un recurso gratuito personalizado."
  keywords="gemelo digital gratis, análisis web negocio, presencia digital pyme, auditoría web gratis"
  schema={{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Gemelo Digital - Soluciones MDP",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    offers: { "@type": "Offer", price: "0", priceCurrency: "ARS", description: "100% gratis" },
    description: "Analizamos tu web y creamos el gemelo digital personalizado de tu presencia digital con un recurso gratis."
  }}
>

<!-- FORMULARIO -->
<section id="form-section" class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-20">
  <div class="max-w-lg w-full">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-medium mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        100% gratis — sin tarjeta — 30 segundos
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold text-white leading-tight mb-4">
        Creá el Gemelo Digital de tu negocio
      </h1>
      <p class="text-slate-400 text-lg">
        Ingresá tu web y te creamos el gemelo digital de tu negocio al instante. Además, te regalamos algo útil para tu negocio.
      </p>
    </div>

    <form id="diag-form" class="space-y-4">
      <div>
        <label for="url" class="block text-sm font-medium text-slate-300 mb-1.5">URL de tu web <span class="text-slate-500">(o dejalo vacío)</span></label>
        <input type="text" id="url" name="url" placeholder="www.tunegocio.com o nombre del local"
          class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-500/50 focus:ring-1 focus:ring-cyan-500/30 transition" />
      </div>
      <div id="nombre-ciudad-row" class="hidden grid grid-cols-2 gap-3">
        <div>
          <label for="nombre_negocio" class="block text-sm font-medium text-slate-300 mb-1.5">Nombre del negocio</label>
          <input type="text" id="nombre_negocio" placeholder="Ej: Lo de Juan"
            class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-500/50 focus:ring-1 focus:ring-cyan-500/30 transition" />
        </div>
        <div>
          <label for="ciudad" class="block text-sm font-medium text-slate-300 mb-1.5">Ciudad</label>
          <input type="text" id="ciudad" placeholder="Ej: Mar del Plata"
            class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-500/50 focus:ring-1 focus:ring-cyan-500/30 transition" />
        </div>
      </div>
      <p id="sin-web-toggle" class="text-xs text-cyan-500 cursor-pointer hover:underline">¿No tenés web? Ingresá el nombre de tu negocio</p>
      <div>
        <label for="email" class="block text-sm font-medium text-slate-300 mb-1.5">Tu email</label>
        <input type="email" id="email" name="email" required placeholder="nombre@email.com"
          class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-500/50 focus:ring-1 focus:ring-cyan-500/30 transition" />
      </div>
      <div>
        <label for="rubro" class="block text-sm font-medium text-slate-300 mb-1.5">Rubro</label>
        <select id="rubro" name="rubro" required
          class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white focus:outline-none focus:border-cyan-500/50 focus:ring-1 focus:ring-cyan-500/30 transition appearance-none">
          <option value="" disabled selected class="text-slate-500 bg-[#0a0a0f]">Elegí tu rubro...</option>
          <option value="restaurante" class="bg-[#0a0a0f]">🍽️ Restaurante / Rotisería / Food truck</option>
          <option value="bar" class="bg-[#0a0a0f]">🍺 Bar / Cervecería / Cafetería</option>
          <option value="peluquería" class="bg-[#0a0a0f]">💇 Peluquería / Barbería</option>
          <option value="estética" class="bg-[#0a0a0f]">💅 Estética / Spa / Podología</option>
          <option value="consultorio" class="bg-[#0a0a0f]">🏥 Consultorio / Centro médico</option>
          <option value="gimnasio" class="bg-[#0a0a0f]">🏋️ Gimnasio / Crossfit / Pilates</option>
          <option value="club" class="bg-[#0a0a0f]">🏟️ Club / Asociación</option>
          <option value="salón de eventos" class="bg-[#0a0a0f]">🎉 Salón de eventos / Quincho</option>
          <option value="cancha" class="bg-[#0a0a0f]">⚽ Cancha de fútbol / Pádel</option>
          <option value="delivery" class="bg-[#0a0a0f]">🛵 Delivery / Viandas</option>
          <option value="distribuidora" class="bg-[#0a0a0f]">📦 Distribuidora / Mensajería</option>
          <option value="electricista" class="bg-[#0a0a0f]">⚡ Electricista / Plomero / Herrería</option>
          <option value="constructora" class="bg-[#0a0a0f]">🏗️ Constructora / Arquitecto</option>
          <option value="profesor" class="bg-[#0a0a0f]">📚 Profesor / Academia / Instituto</option>
          <option value="heladería" class="bg-[#0a0a0f]">🍦 Heladería</option>
          <option value="pizzería" class="bg-[#0a0a0f]">🍕 Pizzería</option>
          <option value="sushi" class="bg-[#0a0a0f]">🍣 Sushi / Comida asiática</option>
        </select>
      </div>
      <button type="submit" id="submit-btn"
        class="w-full py-3.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-lg transition-colors mt-2 cursor-pointer">
        Crear mi Gemelo Digital gratis
      </button>
      <p class="text-center text-xs text-slate-500 mt-2">No spam. Solo tu gemelo digital.</p>
    </form>
  </div>
</section>

<!-- LOADING -->
<section id="loading-section" class="hidden min-h-[calc(100vh-4rem)] flex items-center justify-center px-4">
  <div class="text-center max-w-md">
    <div class="relative w-20 h-20 mx-auto mb-8">
      <div class="absolute inset-0 rounded-full border-2 border-cyan-500/20"></div>
      <div class="absolute inset-0 rounded-full border-2 border-transparent border-t-cyan-400 animate-spin"></div>
      <div class="absolute inset-3 rounded-full border-2 border-transparent border-b-indigo-400 animate-spin" style="animation-direction:reverse;animation-duration:1.5s"></div>
    </div>
    <h2 class="text-xl font-bold text-white mb-3">Analizando tu negocio...</h2>
    <p id="loading-step" class="text-slate-400 transition-opacity duration-500">Accediendo a tu web</p>
    <div class="mt-6 w-full bg-white/5 rounded-full h-1.5 overflow-hidden">
      <div id="loading-bar" class="h-full bg-gradient-to-r from-cyan-500 to-indigo-500 rounded-full transition-all duration-1000 ease-out" style="width:0%"></div>
    </div>
  </div>
</section>

<!-- RESULTADO -->
<section id="result-section" class="hidden py-20 px-4">
  <div class="max-w-4xl mx-auto">

    <!-- Header con puntaje -->
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-extrabold text-white mb-2">
        Gemelo Digital de <span id="r-nombre" class="text-cyan-400"></span>
      </h2>
      <p id="r-descripcion" class="text-slate-400 text-lg"></p>
    </div>

    <!-- Puntaje circular -->
    <div class="flex justify-center mb-12">
      <div class="relative w-40 h-40">
        <svg class="w-full h-full -rotate-90" viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="52" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="8"/>
          <circle id="r-circle" cx="60" cy="60" r="52" fill="none" stroke-width="8" stroke-linecap="round"
            stroke-dasharray="327" stroke-dashoffset="327" class="transition-all duration-[2s] ease-out"/>
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <span id="r-puntaje" class="text-4xl font-extrabold text-white">0</span>
          <span class="text-sm text-slate-400">/10</span>
        </div>
      </div>
    </div>

    <!-- Índice Digital desglosado -->
    <div id="r-scores-section" class="mb-12">
      <h3 class="text-center text-sm text-slate-400 uppercase tracking-wider mb-6">Índice Digital Soluciones MDP</h3>
      <div class="grid grid-cols-5 gap-3" id="r-scores"></div>
    </div>

    <!-- Grid fortalezas / debilidades -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6">
        <h3 class="text-emerald-400 font-semibold mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Lo que hacés bien
        </h3>
        <ul id="r-fortalezas" class="space-y-2 text-slate-300"></ul>
      </div>
      <div class="rounded-xl border border-red-500/20 bg-red-500/5 p-6">
        <h3 class="text-red-400 font-semibold mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Oportunidades de mejora
        </h3>
        <ul id="r-debilidades" class="space-y-2 text-slate-300"></ul>
      </div>
    </div>

    <!-- Recomendación -->
    <div id="r-recomendacion-box" class="rounded-xl border border-indigo-500/20 bg-indigo-500/5 p-6 mb-12">
      <h3 class="text-indigo-400 font-semibold mb-2">Nuestra recomendación</h3>
      <p id="r-recomendacion" class="text-slate-300 text-lg"></p>
    </div>

    <!-- PREVIEW: recurso gratis -->
    <div id="r-preview-section" class="mb-12">
      <div class="text-center mb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-medium mb-3">
          🎁 Recurso gratuito
        </div>
        <h3 class="text-xl md:text-2xl font-bold text-white">Mirá lo que armamos para tu negocio</h3>
        <p class="text-slate-400 mt-1">Esto es tuyo, gratis, sin compromiso.</p>
      </div>
      <div id="r-preview" class="rounded-xl border border-white/10 bg-white/[0.03] p-6 overflow-x-auto"></div>
    </div>

    <!-- Link compartible -->
    <div id="r-link-section" class="hidden mb-12">
      <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-6 text-center">
        <p class="text-xs text-cyan-400 uppercase tracking-wider mb-2">Tu link compartible</p>
        <p class="text-slate-400 text-sm mb-3">Compartilo por WhatsApp, redes o imprimilo en un QR</p>
        <div class="flex items-center gap-2 max-w-md mx-auto">
          <input id="r-link-input" type="text" readonly class="flex-1 px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white text-sm font-mono truncate" />
          <button id="r-link-copy" class="px-4 py-2.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white text-sm font-medium transition-colors whitespace-nowrap">Copiar</button>
        </div>
        <p id="r-link-copied" class="text-emerald-400 text-xs mt-2 hidden">Copiado al portapapeles</p>
        <a id="r-share-wa" href="#" target="_blank"
          class="inline-flex items-center gap-2 mt-4 px-6 py-2.5 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white font-semibold text-sm transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.019-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.611.611l4.458-1.495A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.353 0-4.527-.804-6.254-2.152l-.438-.352-3.03 1.016 1.016-3.03-.352-.438A9.96 9.96 0 012 12C2 6.486 6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"/></svg>
          Compartir por WhatsApp
        </a>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center rounded-xl border border-cyan-500/20 bg-gradient-to-br from-cyan-500/10 to-indigo-500/10 p-8">
      <h3 class="text-xl font-bold text-white mb-2">¿Querés probarlo completo?</h3>
      <p class="text-slate-400 mb-6">28 días gratis. Sin tarjeta. Sin compromiso. Cancela cuando quieras.</p>
      <a id="r-cta" href="#" target="_blank"
        class="inline-block px-8 py-3.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-lg transition-colors">
        Probar <span id="r-app-name">la app</span> gratis
      </a>
      <p class="text-xs text-slate-500 mt-3">O escribinos por <a href="https://wa.me/542235767784" target="_blank" class="text-cyan-500 hover:underline">WhatsApp</a></p>
    </div>

  </div>
</section>

<!-- Señales técnicas -->
<section id="r-senales-section" class="hidden pb-20 px-4">
  <div class="max-w-4xl mx-auto">
    <h3 class="text-lg font-semibold text-white mb-4">Señales técnicas detectadas</h3>
    <div id="r-senales" class="grid grid-cols-2 md:grid-cols-3 gap-3"></div>
  </div>
</section>

</Layout>

<script define:vars={{ APP_URLS, APP_NAMES }}>
const API = 'https://baileys-soluciones.fly.dev';

const form = document.getElementById('diag-form');
const formSection = document.getElementById('form-section');
const loadingSection = document.getElementById('loading-section');
const resultSection = document.getElementById('result-section');
const senalesSection = document.getElementById('r-senales-section');
const loadingStep = document.getElementById('loading-step');
const loadingBar = document.getElementById('loading-bar');

const steps = [
  'Accediendo a tu web',
  'Escaneando contenido',
  'Detectando señales',
  'Analizando con inteligencia artificial',
  'Armando tu recurso gratuito',
];

// Toggle sin web
const sinWebToggle = document.getElementById('sin-web-toggle');
const nombreCiudadRow = document.getElementById('nombre-ciudad-row');
sinWebToggle.addEventListener('click', () => {
  const showing = !nombreCiudadRow.classList.contains('hidden');
  nombreCiudadRow.classList.toggle('hidden');
  sinWebToggle.textContent = showing ? '¿No tenés web? Ingresá el nombre de tu negocio' : '↑ Tengo web, quiero poner la URL';
});

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  let url = document.getElementById('url').value.trim();
  const email = document.getElementById('email').value.trim();
  const rubro = document.getElementById('rubro').value;
  let nombre_negocio = document.getElementById('nombre_negocio')?.value?.trim() || '';
  const ciudad = document.getElementById('ciudad')?.value?.trim() || '';

  // Si escribieron algo en URL que no parece una URL real, tratarlo como nombre
  const looksLikeUrl = /^(https?:\/\/|[a-z0-9][-a-z0-9]*\.[a-z]{2,})/i;
  if (url && !looksLikeUrl.test(url)) {
    if (!nombre_negocio) nombre_negocio = url;
    url = '';
  }
  if (url && !url.match(/^https?:\/\//i)) url = 'https://' + url;

  if (!url && !nombre_negocio) {
    alert('Ingresá tu web o el nombre de tu negocio');
    return;
  }

  formSection.classList.add('hidden');
  loadingSection.classList.remove('hidden');

  let stepIdx = 0;
  const stepInterval = setInterval(() => {
    stepIdx++;
    if (stepIdx < steps.length) {
      loadingStep.style.opacity = '0';
      setTimeout(() => {
        loadingStep.textContent = steps[stepIdx];
        loadingStep.style.opacity = '1';
      }, 300);
      loadingBar.style.width = `${(stepIdx / steps.length) * 90}%`;
    }
  }, 3000);

  try {
    const res = await fetch(`${API}/gemelo-digital`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url: url || undefined, email, rubro, nombre_negocio: nombre_negocio || undefined, ciudad: ciudad || undefined }),
    });

    clearInterval(stepInterval);

    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.error || 'Error al analizar');
    }

    const data = await res.json();
    loadingBar.style.width = '100%';
    await new Promise(r => setTimeout(r, 500));

    renderResult(data);

  } catch (err) {
    clearInterval(stepInterval);
    loadingSection.classList.add('hidden');
    formSection.classList.remove('hidden');
    alert('No pudimos analizar tu web. Revisá la URL e intentá de nuevo.\n\n' + (err.message || ''));
  }
});

function renderResult(d) {
  loadingSection.classList.add('hidden');
  resultSection.classList.remove('hidden');
  window.scrollTo({ top: 0, behavior: 'smooth' });

  document.getElementById('r-nombre').textContent = d.nombre || 'tu negocio';
  document.getElementById('r-descripcion').textContent = d.descripcion || '';

  // Puntaje con animación
  const puntaje = d.puntaje || 5;
  const circle = document.getElementById('r-circle');
  const puntajeEl = document.getElementById('r-puntaje');

  const color = puntaje >= 7 ? '#10b981' : puntaje >= 4 ? '#f59e0b' : '#ef4444';
  circle.setAttribute('stroke', color);
  const offset = 327 - (327 * puntaje / 10);
  setTimeout(() => {
    circle.style.strokeDashoffset = offset;
  }, 100);

  let count = 0;
  const counterInterval = setInterval(() => {
    count++;
    puntajeEl.textContent = count;
    if (count >= puntaje) clearInterval(counterInterval);
  }, 150);

  // Scores desglosados
  if (d.scores) {
    const labels = { presencia: 'Presencia', comunicacion: 'Comunicación', conversion: 'Conversión', confianza: 'Confianza', informacion: 'Información' };
    const icons = { presencia: '🌐', comunicacion: '💬', conversion: '🛒', confianza: '⭐', informacion: '📋' };
    const scoresEl = document.getElementById('r-scores');
    scoresEl.innerHTML = Object.entries(labels).map(([key, label]) => {
      const val = d.scores[key] || 0;
      const color = val >= 7 ? '#10b981' : val >= 4 ? '#f59e0b' : '#ef4444';
      return `<div class="text-center">
        <div class="relative w-14 h-14 mx-auto mb-2">
          <svg class="w-full h-full -rotate-90" viewBox="0 0 44 44">
            <circle cx="22" cy="22" r="18" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="3"/>
            <circle cx="22" cy="22" r="18" fill="none" stroke="${color}" stroke-width="3" stroke-linecap="round"
              stroke-dasharray="${113}" stroke-dashoffset="${113 - (113 * val / 10)}"/>
          </svg>
          <span class="absolute inset-0 flex items-center justify-center text-sm font-bold text-white">${val}</span>
        </div>
        <p class="text-xs text-slate-400">${icons[key]} ${label}</p>
      </div>`;
    }).join('');
  }

  // Fortalezas
  const fortEl = document.getElementById('r-fortalezas');
  fortEl.innerHTML = (d.fortalezas || []).map(f =>
    `<li class="flex items-start gap-2"><span class="text-emerald-400 mt-0.5">✓</span><span>${f}</span></li>`
  ).join('');

  // Debilidades
  const debEl = document.getElementById('r-debilidades');
  debEl.innerHTML = (d.debilidades || []).map(f =>
    `<li class="flex items-start gap-2"><span class="text-red-400 mt-0.5">✗</span><span>${f}</span></li>`
  ).join('');

  // Recomendación
  document.getElementById('r-recomendacion').textContent = d.recomendacion || '';

  // Preview según app
  renderPreview(d);

  // CTA
  const appId = d.app_id || d.preview_type || 'turnos';
  const ctaEl = document.getElementById('r-cta');
  ctaEl.href = APP_URLS[appId] || '#';
  document.getElementById('r-app-name').textContent = APP_NAMES[appId] || 'la app';

  // Link compartible
  if (d.link) {
    const linkSection = document.getElementById('r-link-section');
    const linkInput = document.getElementById('r-link-input');
    const linkCopy = document.getElementById('r-link-copy');
    const linkCopied = document.getElementById('r-link-copied');
    linkSection.classList.remove('hidden');
    linkInput.value = d.link;
    linkCopy.addEventListener('click', () => {
      navigator.clipboard.writeText(d.link).then(() => {
        linkCopied.classList.remove('hidden');
        linkCopy.textContent = '✓ Copiado';
        setTimeout(() => { linkCopied.classList.add('hidden'); linkCopy.textContent = 'Copiar'; }, 2000);
      });
    });
    const shareWa = document.getElementById('r-share-wa');
    const nombre = d.nombre || 'mi negocio';
    const waText = encodeURIComponent(`Mirá el análisis digital de ${nombre} 👉 ${d.link}\n\nCreá el tuyo gratis en solucionesmdp.com.ar/gemelo-digital`);
    shareWa.href = `https://wa.me/?text=${waText}`;
  }

  // Señales
  if (d.senales) {
    senalesSection.classList.remove('hidden');
    const senalesEl = document.getElementById('r-senales');
    const labels = {
      has_booking: ['Reservas online', '📅'],
      has_menu: ['Menú/carta online', '📋'],
      has_whatsapp: ['WhatsApp visible', '💬'],
      has_instagram: ['Instagram', '📸'],
      has_online_payments: ['Pagos online', '💳'],
      has_reviews_widget: ['Reseñas/testimonios', '⭐'],
      web_is_wordpress: ['WordPress', '🔧'],
      web_is_wix: ['Wix', '🎨'],
      web_has_ssl: ['SSL (seguro)', '🔒'],
      web_has_responsive: ['Responsive', '📱'],
    };
    senalesEl.innerHTML = Object.entries(labels).map(([key, [label, icon]]) => {
      const has = d.senales[key];
      return `<div class="flex items-center gap-2 px-3 py-2 rounded-lg ${has ? 'bg-emerald-500/10 border border-emerald-500/20' : 'bg-white/5 border border-white/10'}">
        <span>${icon}</span>
        <span class="text-sm ${has ? 'text-emerald-300' : 'text-slate-500'}">${label}</span>
        <span class="ml-auto text-xs ${has ? 'text-emerald-400' : 'text-slate-600'}">${has ? 'Sí' : 'No'}</span>
      </div>`;
    }).join('');
  }
}

function renderPreview(d) {
  const container = document.getElementById('r-preview');
  const type = d.preview_type || d.app_id;
  const items = d.items;

  if (!items || (Array.isArray(items) && items.length === 0 && typeof items !== 'object')) {
    document.getElementById('r-preview-section').classList.add('hidden');
    return;
  }

  if (type === 'gastro') {
    const cats = {};
    (items || []).forEach(it => {
      const cat = it.categoria || 'Otros';
      if (!cats[cat]) cats[cat] = [];
      cats[cat].push(it);
    });
    container.innerHTML = `
      <div class="text-center mb-4">
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Vista previa de tu menú digital</p>
        <h4 class="text-lg font-bold text-white">${d.nombre || 'Tu Menú'}</h4>
      </div>
      ${Object.entries(cats).map(([cat, its]) => `
        <div class="mb-4">
          <h5 class="text-sm font-semibold text-cyan-400 border-b border-white/10 pb-1 mb-2">${cat}</h5>
          ${its.map(it => `
            <div class="flex justify-between items-center py-1.5 text-sm">
              <span class="text-slate-300">${it.nombre}</span>
              ${!isNaN(Number(it.precio)) && Number(it.precio) > 0 ? `<span class="text-white font-medium">$${Number(it.precio).toLocaleString('es-AR')}</span>` : ''}
            </div>
          `).join('')}
        </div>
      `).join('')}
      <p class="text-center text-xs text-slate-500 mt-4">Este menú ya está listo para que tus clientes lo escaneen con QR</p>
    `;
  } else if (type === 'turnos') {
    container.innerHTML = `
      <div class="text-center mb-4">
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Vista previa de tu sistema de turnos</p>
        <h4 class="text-lg font-bold text-white">${d.nombre || 'Tus Servicios'}</h4>
      </div>
      <div class="space-y-2">
        ${(items || []).map(it => `
          <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
            <div>
              <p class="text-sm font-medium text-white">${it.nombre}</p>
              <p class="text-xs text-slate-400">${it.duracion_min || 30} min</p>
            </div>
            <div class="text-right">
              ${!isNaN(Number(it.precio)) && Number(it.precio) > 0 ? `<p class="text-white font-medium">$${Number(it.precio).toLocaleString('es-AR')}</p>` : ''}
              <button class="text-xs text-cyan-400 mt-0.5">Reservar →</button>
            </div>
          </div>
        `).join('')}
      </div>
      <p class="text-center text-xs text-slate-500 mt-4">Link de reservas listo para compartir con tus clientes</p>
    `;
  } else if (type === 'quincho') {
    container.innerHTML = `
      <div class="text-center mb-4">
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Vista previa de tu sistema de reservas</p>
        <h4 class="text-lg font-bold text-white">${d.nombre || 'Tus Espacios'}</h4>
      </div>
      <div class="space-y-2">
        ${(items || []).map(it => {
          const precio = Number(it.precio);
          const precioStr = !isNaN(precio) && precio > 0 ? `$${precio.toLocaleString('es-AR')}` : '';
          return `
          <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
            <div>
              <p class="text-sm font-medium text-white">${it.nombre}</p>
              <p class="text-xs text-slate-400">${it.turno || ''}</p>
            </div>
            ${precioStr ? `<p class="text-white font-medium">${precioStr}</p>` : '<button class="text-xs text-cyan-400">Reservar →</button>'}
          </div>`;
        }).join('')}
      </div>
      <p class="text-center text-xs text-slate-500 mt-4">Calendario de disponibilidad listo para compartir con tus clientes</p>
    `;
  } else if (type === 'membresias') {
    container.innerHTML = `
      <div class="text-center mb-4">
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Vista previa de tu sistema de membresías</p>
        <h4 class="text-lg font-bold text-white">${d.nombre || 'Tus Actividades'}</h4>
      </div>
      <div class="space-y-2">
        ${(items || []).map(it => `
          <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
            <div>
              <p class="text-sm font-medium text-white">${it.nombre}</p>
              <p class="text-xs text-slate-400">${it.frecuencia || ''}</p>
            </div>
            ${!isNaN(Number(it.precio_mensual)) && Number(it.precio_mensual) > 0 ? `<p class="text-white font-medium">$${Number(it.precio_mensual).toLocaleString('es-AR')}/mes</p>` : ''}
          </div>
        `).join('')}
      </div>
    `;
  } else if (type === 'reparto') {
    container.innerHTML = `
      <div class="text-center mb-4">
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Vista previa de tu catálogo de delivery</p>
        <h4 class="text-lg font-bold text-white">${d.nombre || 'Tus Productos'}</h4>
      </div>
      <div class="space-y-2">
        ${(items || []).map(it => `
          <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
            <span class="text-sm text-white">${it.nombre}</span>
            ${!isNaN(Number(it.precio)) && Number(it.precio) > 0 ? `<span class="text-white font-medium">$${Number(it.precio).toLocaleString('es-AR')} ${it.unidad ? '/ ' + it.unidad : ''}</span>` : ''}
          </div>
        `).join('')}
      </div>
    `;
  } else if (type === 'presup') {
    const total = (items || []).reduce((s, it) => s + (it.cantidad || 1) * (it.precio_unitario || 0), 0);
    container.innerHTML = `
      <div class="text-center mb-4">
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Vista previa de presupuesto digital</p>
        <h4 class="text-lg font-bold text-white">${d.nombre || 'Presupuesto'}</h4>
      </div>
      <table class="w-full text-sm">
        <thead><tr class="text-slate-400 border-b border-white/10">
          <th class="text-left py-2">Descripción</th><th class="text-right py-2">Cant.</th><th class="text-right py-2">P. Unit.</th><th class="text-right py-2">Subtotal</th>
        </tr></thead>
        <tbody>
          ${(items || []).map(it => `
            <tr class="border-b border-white/5">
              <td class="py-2 text-slate-300">${it.descripcion}</td>
              <td class="py-2 text-right text-slate-400">${it.cantidad || 1}</td>
              <td class="py-2 text-right text-slate-400">$${Number(it.precio_unitario || 0).toLocaleString('es-AR')}</td>
              <td class="py-2 text-right text-white font-medium">$${((it.cantidad || 1) * (it.precio_unitario || 0)).toLocaleString('es-AR')}</td>
            </tr>
          `).join('')}
        </tbody>
        <tfoot><tr class="border-t border-white/20">
          <td colspan="3" class="py-2 text-right font-semibold text-slate-300">TOTAL</td>
          <td class="py-2 text-right text-lg font-bold text-cyan-400">$${total.toLocaleString('es-AR')}</td>
        </tr></tfoot>
      </table>
    `;
  } else if (type === 'contratista') {
    const obra = items;
    if (obra && obra.nombre_obra) {
      container.innerHTML = `
        <div class="text-center mb-4">
          <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Vista previa de gestión de obra</p>
          <h4 class="text-lg font-bold text-white">${obra.nombre_obra}</h4>
        </div>
        <div class="space-y-2 mb-4">
          ${(obra.gremios || []).map(g => `
            <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
              <span class="text-sm text-white">${g.nombre}</span>
              <span class="text-white font-medium">$${Number(g.monto || 0).toLocaleString('es-AR')}</span>
            </div>
          `).join('')}
        </div>
        <div class="flex justify-between items-center pt-3 border-t border-white/20">
          <span class="font-semibold text-slate-300">Total obra</span>
          <span class="text-lg font-bold text-cyan-400">$${Number(obra.monto_total || 0).toLocaleString('es-AR')}</span>
        </div>
      `;
    }
  } else if (type === 'docentes') {
    const t = items;
    container.innerHTML = `
      <div class="text-center mb-4">
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Tu tarjeta digital gratuita</p>
      </div>
      <div class="max-w-sm mx-auto rounded-xl border border-white/10 bg-gradient-to-br from-green-500/10 to-emerald-500/5 p-6 text-center">
        <h4 class="text-lg font-bold text-white mb-1">${d.nombre || 'Tu nombre'}</h4>
        <p class="text-sm text-slate-400 mb-4">${t.slogan || ''}</p>
        ${(t.servicios || []).length ? `
          <div class="flex flex-wrap justify-center gap-2 mb-4">
            ${t.servicios.map(s => `<span class="px-2 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-xs text-green-300">${s}</span>`).join('')}
          </div>
        ` : ''}
        <p class="text-xs text-slate-400">${t.horarios || ''}</p>
      </div>
    `;
  } else {
    document.getElementById('r-preview-section').classList.add('hidden');
  }
}
</script>
