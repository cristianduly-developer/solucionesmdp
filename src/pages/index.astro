---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    slug: 'eventos',
    name: 'App Eventos',
    rubro: 'Espacios y canchas',
    desc: 'Calendario de disponibilidad, cobros parciales y recordatorios automáticos para quinchos, salones de fiestas y canchas de pádel.',
    screenshot: '/screenshots/eventos/calendario.jpg',
    features: ['Calendario interactivo', 'Señas y pagos parciales', 'WhatsApp integrado', 'Múltiples espacios'],
  },
  {
    slug: 'gastronomia',
    name: 'App Gastronomía',
    rubro: 'Restaurantes y food trucks',
    desc: 'Mesas en tiempo real, monitor de cocina, menú QR con pedidos y delivery integrado.',
    screenshot: '/screenshots/gastronomia/mesas.jpg',
    features: ['Mesas en tiempo real', 'Monitor de cocina', 'Menú QR', 'Delivery integrado'],
  },
  {
    slug: 'turnos',
    name: 'App Turnos',
    rubro: 'Estética, belleza y salud',
    desc: 'Agenda online con reservas 24/7, gestión de clientes, múltiples profesionales y cobros automáticos.',
    screenshot: '/screenshots/turnos/agenda.jpg',
    features: ['Reservas 24/7', 'Link propio', 'Múltiples profesionales', 'Señas y cobros'],
  },
  {
    slug: 'contratista',
    name: 'App Contratista',
    rubro: 'Construcción',
    desc: 'Ganancia neta por obra en tiempo real, pagos a gremios, vista financiera semanal y calculadora por m2.',
    screenshot: '/screenshots/contratista/dashboard.jpg',
    features: ['Ganancia neta en tiempo real', 'Links para gremios', 'Vista financiera semanal', 'Calculadora por m2'],
  },
  {
    slug: 'membresias',
    name: 'App Membresías',
    rubro: 'Gimnasios y clubes',
    desc: 'Gestión de socios, cobros automatizados, check-in con QR y alertas de vencimiento.',
    screenshot: '/screenshots/membresias/dashboard.jpg',
    features: ['Socios y membresías', 'Check-in QR', 'Alertas de vencimiento', 'Cobros y caja'],
  },
  {
    slug: 'reparto',
    name: 'App Reparto',
    rubro: 'Distribución',
    desc: 'Pedidos, rutas, stock y cobros que funcionan incluso sin internet.',
    screenshot: '/screenshots/reparto/pedidos.jpg',
    features: ['100% offline', 'Ruta con IA', 'Cuentas corrientes', 'Multi-usuario'],
  },
  {
    slug: 'docente',
    name: 'App Docente',
    rubro: 'Educación especial',
    desc: 'Registros de clase por voz, adaptaciones curriculares con IA e informes PDF listos para entregar.',
    screenshot: '/screenshots/docente/mapa-dia.jpg',
    features: ['Registros por voz + IA', 'Adaptación de tareas', 'Informes PDF', 'Fichas de alumnos'],
  },
  {
    slug: 'presup',
    name: 'App Presupuesto',
    rubro: 'Oficios y servicios',
    desc: 'Presupuestos profesionales en 2 minutos con firma digital del cliente y seguimiento de obras.',
    screenshot: '/screenshots/presup/presupuestos.jpg',
    features: ['PDF con firma digital', 'Gestión de obras', 'Reportes financieros', 'Agenda de visitas'],
  },
  {
    slug: null,
    name: 'PropAdmin',
    rubro: 'Administración inmobiliaria',
    desc: 'Sistema multi-tenant para administradoras: alquileres, cobros, propietarios, inquilinos y documentación.',
    screenshot: null,
    features: ['Multi-tenant', 'Cobros automatizados', 'Portal propietarios', 'Gestión documental'],
  },
  {
    slug: null,
    name: 'App Distribución',
    rubro: 'Distribución mayorista',
    desc: 'ERP completo para distribuidores de frutas y verduras: pedidos, mercado, facturación y logística.',
    screenshot: null,
    features: ['Pedidos y despacho', 'Compras en mercado', 'Facturación', 'Cuentas corrientes'],
  },
  {
    slug: 'taller',
    name: 'App Taller',
    rubro: 'Talleres mecánicos',
    desc: 'Órdenes de trabajo, presupuestos con aprobación online, tablero Kanban y historial por patente.',
    screenshot: null,
    features: ['Órdenes de trabajo', 'Aprobación online', 'Kanban de estado', 'Historial por patente'],
    badge: 'En desarrollo',
  },
];

const problems = [
  { problem: 'Tus clientes te llaman a cualquier hora para preguntar si hay turno', solution: 'Agenda online con reservas 24/7. El cliente elige el horario y vos te enterás cuando querés.' },
  { problem: 'Llevás las reservas en un Excel y se te superponen fechas', solution: 'Calendario visual con bloqueo automático. Nunca más una doble reserva.' },
  { problem: 'Hacés presupuestos a mano y después perdés el seguimiento de cobros', solution: 'Presupuestos en PDF con firma digital. Estado de cada obra y cobro, siempre actualizado.' },
  { problem: 'Tu repartidor sale con una lista en papel y siempre se olvida algo', solution: 'App que funciona sin internet. Cada parada con detalle de entrega, cobro y firma.' },
  { problem: 'Perseguís a tus socios para que paguen la cuota del gimnasio', solution: 'Alertas automáticas de vencimiento, check-in con QR y estado de cuenta al instante.' },
  { problem: 'Las comandas se pierden entre la cocina y el salón', solution: 'Mesas en tiempo real con monitor de cocina. Cada pedido llega al instante.' },
];

const testimonials = [
  { name: 'Hernán L.', role: 'Dueño de quincho', location: 'Mar del Plata', text: 'Antes llevaba las reservas en un Excel y más de una vez se me superpusieron. Desde que uso la app, cada cliente reserva solo, paga la seña por transferencia y yo no toco nada.', app: 'App Eventos' },
  { name: 'Marcos V.', role: 'Distribuidor de agua', location: 'Rosario', text: 'Mi repartidor salía con una lista a mano y siempre faltaba algo. Ahora carga todo en el celular, hasta sin señal, y cuando vuelve ya están los cobros actualizados.', app: 'App Reparto' },
  { name: 'Sabrina M.', role: 'Manicura', location: 'Mar del Plata', text: 'Mis clientas me llamaban a cualquier hora para pedir turno. Ahora entran al link, eligen el horario que quieren y listo. Yo ni me entero hasta que veo la agenda al otro día.', app: 'App Turnos' },
  { name: 'Roberto S.', role: 'Plomero', location: 'Buenos Aires', text: 'Hacía los presupuestos en Word, los mandaba por WhatsApp y después no sabía cuáles me habían aprobado. Ahora el cliente firma desde el celular y me llega la notificación.', app: 'App Presupuesto' },
  { name: 'Florencia P.', role: 'Maestra integradora', location: 'CABA', text: 'Salía de la escuela y tardaba media hora en escribir los registros de clase. Ahora los dicto por voz en 30 segundos y la app los organiza sola con inteligencia artificial.', app: 'App Docente' },
  { name: 'Alejandro V.', role: 'Electricista', location: 'Córdoba', text: 'Tenía presupuestos y cobros desparramados en WhatsApp, notas del celular y un Excel que nunca actualizaba. Ahora abro la app y sé exactamente cuánto me deben en cada obra.', app: 'App Presupuesto' },
];

const industries = ['Peluquerías', 'Restaurantes', 'Gimnasios', 'Quinchos', 'Constructoras', 'Distribuidores', 'Talleres', 'Salones de fiesta', 'Kinesiólogos', 'Food trucks', 'Administradoras', 'Electricistas', 'Plomeros', 'Canchas de pádel', 'Docentes', 'Rotiserías', 'Clubes deportivos', 'Dark kitchens', 'Spas', 'Barberías'];
---

<Layout
  title="Inicio"
  description="Estudio de desarrollo de software en Mar del Plata. Diseñamos y construimos apps a medida para negocios reales. Más de 12 apps en producción."
  keywords="desarrollo de software, apps a medida, software para negocios, Mar del Plata, desarrollo web, apps de gestión"
>

  <!-- ═══ HERO ═══ -->
  <section class="hero-glow hero-spotlight dot-grid relative min-h-[90vh] flex items-center" id="hero-section">
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-28 md:py-36">
      <div class="anim-1 inline-flex items-center gap-2 px-3 py-1.5 rounded-full mb-8" style="border: 1px solid var(--border); background: rgba(255,255,255,0.02); color: var(--text-muted); font-size: 13px;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background: var(--accent);"></span>
        Estudio de desarrollo · Mar del Plata
      </div>

      <h1 class="anim-2 headline text-[clamp(36px,6vw,64px)] max-w-[720px] mb-5">
        Convertimos problemas<br/>
        <span class="gradient-text">en software que funciona</span>
      </h1>

      <p class="anim-3 max-w-lg mb-10 leading-relaxed" style="color: var(--text-muted); font-size: 16px;">
        Diseñamos, construimos y acompañamos apps a medida para negocios que necesitan dejar de improvisar con Excel, WhatsApp y cuadernos.
      </p>

      <div class="anim-4 flex flex-col sm:flex-row gap-3 mb-20">
        <a href="#proyectos" class="btn-primary py-2.5 px-6">
          Ver proyectos
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" /></svg>
        </a>
        <a href="https://wa.me/542236965481?text=Hola!%20Quiero%20saber%20más%20sobre%20sus%20servicios%20de%20desarrollo" target="_blank" class="btn-ghost py-2.5 px-6">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Hablemos de tu proyecto
        </a>
      </div>

      <div class="anim-5 flex items-center gap-10">
        <div>
          <div class="text-[28px] font-semibold" style="color: var(--text); font-variant-numeric: tabular-nums;">12+</div>
          <div class="text-[13px]" style="color: var(--text-faint);">Apps en producción</div>
        </div>
        <div class="w-px h-10" style="background: var(--border);"></div>
        <div>
          <div class="text-[28px] font-semibold" style="color: var(--text); font-variant-numeric: tabular-nums;">10</div>
          <div class="text-[13px]" style="color: var(--text-faint);">Industrias</div>
        </div>
        <div class="w-px h-10 hidden sm:block" style="background: var(--border);"></div>
        <div class="hidden sm:block">
          <div class="text-[28px] font-semibold" style="color: var(--accent);">100%</div>
          <div class="text-[13px]" style="color: var(--text-faint);">Soporte directo</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ticker -->
  <div class="section-alt py-3 overflow-hidden">
    <div class="marquee-track">
      {[...industries, ...industries].map(ind => (
        <span class="text-[13px] whitespace-nowrap" style="color: var(--text-faint);">{ind}</span>
      ))}
    </div>
  </div>


  <!-- ═══ SERVICIOS ═══ -->
  <section id="servicios" class="max-w-[1200px] mx-auto px-6 py-24 md:py-28">
    <div class="reveal mb-14">
      <p class="text-[12px] font-semibold tracking-widest uppercase mb-3" style="color: var(--accent);">Servicios</p>
      <h2 class="headline text-[clamp(28px,4vw,40px)] mb-4">Software a medida, no genérico</h2>
      <p class="text-[16px] max-w-xl" style="color: var(--text-muted);">Cada proyecto se diseña desde cero para el rubro del cliente. No adaptamos plantillas.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-4">
      {[
        { title: 'Apps de gestión', desc: 'Turnos, reservas, presupuestos, despacho, membresías. Diseñadas para rubros específicos, listas para usar desde el celular.', icon: `<svg class="w-5 h-5" style="color:var(--accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>` },
        { title: 'ERPs verticales', desc: 'Sistemas completos para operaciones complejas: distribución mayorista, administración inmobiliaria, gestión de obras.', icon: `<svg class="w-5 h-5" style="color:var(--accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>` },
        { title: 'Webs y landing pages', desc: 'Sitios institucionales, landing pages y apps web progresivas. Diseño, desarrollo y publicación.', icon: `<svg class="w-5 h-5" style="color:var(--accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>` },
      ].map((s, i) => (
        <div class={`reveal reveal-d${i+1} card p-6`}>
          <div class="w-9 h-9 rounded-lg flex items-center justify-center mb-4" style="background: var(--accent-muted); border: 1px solid rgba(99,102,241,0.15);" set:html={s.icon} />
          <h3 class="text-[15px] font-semibold mb-2" style="color: var(--text);">{s.title}</h3>
          <p class="text-[14px] leading-relaxed" style="color: var(--text-muted);">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>


  <!-- ═══ PROBLEMAS ═══ -->
  <section class="section-alt">
    <div class="max-w-[1200px] mx-auto px-6 py-24 md:py-28">
      <div class="reveal mb-14">
        <p class="text-[12px] font-semibold tracking-widest uppercase mb-3" style="color: var(--accent);">Problemas reales</p>
        <h2 class="headline text-[clamp(28px,4vw,40px)] mb-4">¿Te suena alguno?</h2>
        <p class="text-[16px] max-w-xl" style="color: var(--text-muted);">Estos son los problemas que nuestros usuarios tenían antes de contactarnos.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {problems.map((p, i) => (
          <div class={`reveal reveal-d${(i % 6)+1} card-static p-6`}>
            <p class="text-[14px] font-medium mb-3 leading-snug" style="color: var(--text);">"{p.problem}"</p>
            <p class="text-[13px] leading-relaxed" style="color: var(--text-muted);">{p.solution}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ PORTFOLIO ═══ -->
  <section id="proyectos" class="max-w-[1200px] mx-auto px-6 py-24 md:py-28">
    <div class="reveal mb-14">
      <p class="text-[12px] font-semibold tracking-widest uppercase mb-3" style="color: var(--accent);">Portfolio</p>
      <h2 class="headline text-[clamp(28px,4vw,40px)] mb-4">Lo que construimos</h2>
      <p class="text-[16px] max-w-xl" style="color: var(--text-muted);">Cada app está diseñada desde cero para su rubro. Todas en producción, usadas por negocios reales.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((project, i) => {
        const waMsg = encodeURIComponent(`Hola! Me interesa ver una demo de ${project.name}. ¿Podemos coordinar?`);
        return (
          <div class={`reveal reveal-d${(i % 6)+1} card group overflow-hidden`}>
            <div class="aspect-[16/10] overflow-hidden relative" style="background: var(--bg-elevated);">
              {project.screenshot ? (
                <img src={project.screenshot} alt={project.name}
                  class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-2xl font-semibold" style="color: var(--text-faint); opacity: 0.4;">{project.name}</span>
                </div>
              )}
              {project.badge && (
                <span class="absolute top-2.5 right-2.5 chip text-[11px]">{project.badge}</span>
              )}
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-2.5">
                <span class="chip">{project.rubro}</span>
              </div>
              <h3 class="text-[15px] font-semibold mb-1.5" style="color: var(--text);">{project.name}</h3>
              <p class="text-[13px] mb-4 leading-relaxed" style="color: var(--text-muted);">{project.desc}</p>
              <div class="flex flex-wrap gap-1 mb-4">
                {project.features.map(f => (
                  <span class="text-[11px] px-2 py-0.5 rounded" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); color: var(--text-faint);">{f}</span>
                ))}
              </div>
              <a href={`https://wa.me/542236965481?text=${waMsg}`} target="_blank"
                class="inline-flex items-center gap-1.5 text-[13px] font-medium transition-colors" style="color: var(--accent);">
                Solicitar demo
                <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" /></svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>


  <!-- ═══ PROCESO ═══ -->
  <section id="proceso" class="section-alt">
    <div class="max-w-[1200px] mx-auto px-6 py-24 md:py-28">
      <div class="reveal mb-14">
        <p class="text-[12px] font-semibold tracking-widest uppercase mb-3" style="color: var(--accent);">Proceso</p>
        <h2 class="headline text-[clamp(28px,4vw,40px)] mb-4">Cómo trabajamos</h2>
        <p class="text-[16px] max-w-xl" style="color: var(--text-muted);">Sin burocracia, sin reuniones eternas. Directo.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        {[
          { n: '01', title: 'Nos contactás', desc: 'Nos contás qué hace tu negocio, qué problema querés resolver y cómo trabajás hoy. Por WhatsApp o videollamada.' },
          { n: '02', title: 'Diseñamos juntos', desc: 'Te mostramos cómo va a funcionar tu app antes de construirla. Iteramos hasta que refleje tu operación.' },
          { n: '03', title: 'Desarrollamos y acompañamos', desc: 'Construimos, publicamos y capacitamos. Después: soporte directo, actualizaciones y mejoras continuas.' },
        ].map((step, i) => (
          <div class={`reveal reveal-d${i+1} card p-6 relative`}>
            <span class="absolute top-5 right-5 text-[48px] font-bold leading-none" style="color: rgba(255,255,255,0.03);">{step.n}</span>
            <h3 class="text-[15px] font-semibold mb-2" style="color: var(--text);">{step.title}</h3>
            <p class="text-[13px] leading-relaxed" style="color: var(--text-muted);">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ TESTIMONIOS ═══ -->
  <section id="testimonios" class="max-w-[1200px] mx-auto px-6 py-24 md:py-28">
    <div class="reveal mb-14">
      <p class="text-[12px] font-semibold tracking-widest uppercase mb-3" style="color: var(--accent);">Testimonios</p>
      <h2 class="headline text-[clamp(28px,4vw,40px)] mb-4">Lo que dicen quienes nos eligieron</h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {testimonials.map((t, i) => (
        <div class={`reveal reveal-d${(i % 6)+1} card-static p-6 flex flex-col`}>
          <p class="text-[14px] leading-relaxed flex-1 mb-4" style="color: var(--text-muted);">"{t.text}"</p>
          <div class="pt-4" style="border-top: 1px solid var(--border);">
            <p class="text-[13px] font-medium" style="color: var(--text);">{t.name}</p>
            <p class="text-[12px]" style="color: var(--text-faint);">{t.role} · {t.location}</p>
            <p class="text-[12px] font-medium mt-1" style="color: var(--accent);">{t.app}</p>
