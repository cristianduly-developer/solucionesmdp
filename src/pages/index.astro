---
import Layout from '../layouts/Layout.astro';

const apps = [
  { name: 'Turnos', subtitle: 'Agenda para estética, belleza y salud', features: ['Reservas 24/7', 'Link propio del negocio', 'Múltiples profesionales', 'Señas y cobros'], color: 'oklch(72% 0.18 5)', href: '/turnos', status: 'Activa' },
  { name: 'Contratista', subtitle: 'Obras, gremios y finanzas sin Excel', features: ['Ganancia neta en tiempo real', 'Links para gremios sin cuenta', 'Vista financiera semanal', 'Calculadora por m²'], color: 'oklch(72% 0.18 50)', href: '/contratista', status: 'Activa' },
  { name: 'Presupuesto', subtitle: 'El sistema operativo de tu oficio', features: ['PDF con firma digital', 'Gestión de obras', 'Reportes financieros', 'Agenda de visitas'], color: 'oklch(65% 0.20 220)', href: '/presup', status: 'Activa' },
  { name: 'Reparto', subtitle: 'Gestión de distribución sin papel', features: ['100% offline', 'Ruta optimizada con IA', 'Cuentas corrientes', 'Multi-usuario con roles'], color: 'oklch(72% 0.18 170)', href: '/reparto', status: 'Activa' },
  { name: 'Docente', subtitle: 'Para maestras de apoyo e integradoras', features: ['Registros por voz + IA', 'Adaptación de tareas', 'Informes PDF con firma', 'Fichas de alumnos'], color: 'oklch(65% 0.18 300)', href: '/docente', status: 'Activa' },
  { name: 'Eventos', subtitle: 'Reservas de espacios sin caos', features: ['Temporadas de precios', 'WhatsApp integrado', 'Múltiples espacios', 'Señas y pagos parciales'], color: 'oklch(72% 0.18 30)', href: '/eventos', status: 'Activa' },
  { name: 'Gastro', subtitle: 'Tu local, todo en tiempo real', features: ['Mesas en tiempo real', 'Monitor de cocina', 'Menú QR con pedidos', 'Delivery integrado'], color: 'oklch(65% 0.18 15)', href: '/gastronomia', status: 'Activa' },
  { name: 'Membresías', subtitle: 'Socios, cobros y asistencia sin perseguir a nadie', features: ['Check-in QR', 'Alertas de vencimiento', 'Cobros y caja', 'Socios y membresías'], color: 'oklch(65% 0.18 280)', href: '/membresias', status: 'Activa' },
  { name: 'Web', subtitle: 'Tu presencia online, sin complicaciones', features: ['Landing profesional', 'Dominio .com.ar incluido', 'Optimizado para Google', 'Entrega en 5–7 días'], color: 'oklch(72% 0.20 145)', href: '/web', status: 'Nuevo', cta: 'Ver más →' },
  { name: 'Taller', subtitle: 'Gestión de taller mecánico sin papel', features: ['Órdenes de trabajo', 'Aprobación por link', 'Kanban de reparaciones', 'Historial por vehículo'], color: 'oklch(65% 0.18 240)', href: '#', status: 'Próximamente', cta: 'Próximamente' },
];

const comparisons = [
  { generic: 'Proveedores', specific: 'Gremios', app: 'Contratista', color: 'oklch(72% 0.18 50)' },
  { generic: 'SKUs / ítems', specific: 'Bidones / cajas', app: 'Reparto', color: 'oklch(72% 0.18 170)' },
  { generic: 'Contactos', specific: 'Alumnos', app: 'Docente', color: 'oklch(65% 0.18 300)' },
  { generic: 'Servicios', specific: 'Turnos', app: 'Agenda', color: 'oklch(72% 0.18 5)' },
  { generic: 'Artículos', specific: 'Platos / comandas', app: 'Gastro', color: 'oklch(65% 0.18 15)' },
  { generic: 'Clientes', specific: 'Socios', app: 'Membresías', color: 'oklch(65% 0.18 280)' },
];

const platformFeatures = [
  { num: '01', title: 'Sin instalación', desc: 'Funcionan desde el navegador del celular. Instalable como app nativa con un toque, sin pasar por tiendas.' },
  { num: '02', title: 'Prueba gratis 28 días', desc: 'Acceso completo sin tarjeta de crédito. Empezás a usarla y decidís si se adapta a tu negocio.' },
  { num: '03', title: 'Hecha para Argentina', desc: 'Precios en pesos, WhatsApp integrado y soporte local. Sin traducciones ni configuraciones raras.' },
  { num: '04', title: 'IA incluida', desc: 'Automatización de tareas repetitivas: adaptaciones curriculares, parseo de pedidos, sugerencias de ruta.' },
  { num: '05', title: 'Tus datos, seguros', desc: 'Cada negocio tiene sus datos aislados. Login con Google, sin contraseñas que recordar.' },
  { num: '06', title: 'Soporte directo', desc: 'Hablás con quien desarrolló la app, no con un chatbot. Respuesta por WhatsApp el mismo día.' },
];

const testimonials = [
  { quote: 'Mis clientas reservan solas a cualquier hora. Me ahorró un montón de idas y vueltas por WhatsApp.', name: 'Sabrina M.', role: 'Manicura · Mar del Plata', app: 'Turnos', color: 'oklch(72% 0.18 5)' },
  { quote: 'Antes tardaba media hora en hacer un presupuesto en Word. Ahora lo hago en dos minutos y el cliente lo firma desde el celular.', name: 'Roberto S.', role: 'Plomero · Buenos Aires', app: 'Presupuesto', color: 'oklch(65% 0.20 220)' },
  { quote: 'El repartidor lleva el celular y ya sabe qué entregar en cada parada. Cero errores.', name: 'Marcos V.', role: 'Distribuidor · Rosario', app: 'Reparto', color: 'oklch(72% 0.18 170)' },
  { quote: 'El registro por voz me cambió la vida. Salgo de cada clase y dicto lo que pasó en 30 segundos.', name: 'Florencia P.', role: 'Maestra integradora · CABA', app: 'Docente', color: 'oklch(65% 0.18 300)' },
];

const faqs = [
  { q: '¿Necesito tarjeta de crédito para la prueba gratis?', a: 'No. Los 28 días de prueba son completamente gratis, sin tarjeta ni datos de pago.' },
  { q: '¿Cómo funciona el login? ¿Tengo que crear usuario y contraseña?', a: 'Usás tu cuenta de Google existente. Un click y adentro — sin usuario ni contraseña nueva.' },
  { q: '¿Funciona en iPhone y en Android?', a: 'Sí. Funciona desde el navegador del celular sin instalación. También podés instalarla como app nativa con un toque, sin pasar por tiendas.' },
  { q: '¿Qué pasa con mis datos cuando termina la prueba?', a: 'Tus datos quedan guardados 30 días después del vencimiento. Si contratás, los recuperás todos.' },
  { q: '¿Puedo usar la app sin internet?', a: 'App Reparto funciona 100% offline. Las demás requieren conexión para sincronizar.' },
  { q: '¿Cuánto cuesta después de los 28 días?', a: 'Los planes arrancan desde $25.000/mes en pesos argentinos, con actualización semestral.' },
];
---

<Layout title="Inicio" navType="landing">

<!-- HERO -->
<section style="min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:128px 48px 96px; position:relative; overflow:hidden;">
  <div style="position:absolute; inset:0; background:radial-gradient(ellipse 80% 55% at 50% 38%, oklch(22% 0.14 265 / 0.32) 0%, transparent 65%), radial-gradient(ellipse 50% 30% at 80% 70%, oklch(20% 0.12 145 / 0.15) 0%, transparent 60%); pointer-events:none;"></div>
  <div style="position:absolute; inset:0; background-image:radial-gradient(oklch(30% 0.04 270 / 0.35) 1px, transparent 1px); background-size:28px 28px; pointer-events:none;"></div>

  <div class="anim-hero" style="position:relative; display:inline-flex; align-items:center; gap:8px; padding:6px 14px; border:1px solid oklch(28% 0.08 265); border-radius:100px; margin-bottom:44px; font-size:12px; color:oklch(60% 0.10 265); letter-spacing:0.06em; text-transform:uppercase; font-weight:600;">
    <span style="width:6px; height:6px; border-radius:50%; background:oklch(72% 0.20 145); display:inline-block; animation:pulse 2s ease infinite;"></span>
    Vertical SaaS · Mar del Plata, Argentina
  </div>

  <h1 class="font-syne anim-hero-1" style="position:relative; font-size:clamp(52px,7.5vw,96px); font-weight:800; line-height:1.02; letter-spacing:-0.035em; max-width:900px; margin-bottom:20px; text-wrap:balance;">
    La app que dice<br />«<span id="animated-word" style="color:oklch(72% 0.20 145); font-style:italic; animation:wordFadeIn 0.55s cubic-bezier(0.22,1,0.36,1) forwards;">gremios</span>»
  </h1>

  <p class="anim-hero-2" style="position:relative; font-size:18px; color:oklch(52% 0.04 270); max-width:520px; margin-bottom:14px; line-height:1.7; font-weight:300;">
    No «proveedores» ni «clientes genéricos».<br />La palabra exacta de tu rubro, en cada pantalla.
  </p>
  <p class="anim-hero-2" style="position:relative; font-size:12px; color:oklch(36% 0.04 270); margin-bottom:44px; letter-spacing:0.03em;">
    Desde $25.000/mes · 28 días de prueba gratis · Sin tarjeta de crédito · Precios en pesos argentinos
  </p>

  <div class="anim-hero-3" style="position:relative; display:flex; gap:12px; align-items:center; flex-wrap:wrap; justify-content:center;">
    <a href="#apps" style="background:oklch(68% 0.22 265); color:#fff; padding:14px 28px; border-radius:10px; font-weight:600; font-size:15px; letter-spacing:0.01em; transition:background 0.2s;" onmouseover="this.style.background='oklch(72% 0.22 265)'" onmouseout="this.style.background='oklch(68% 0.22 265)'">
      Ver todas las apps
    </a>
    <a href="https://wa.me/542236965481" target="_blank" style="background:oklch(13% 0.04 270); border:1px solid oklch(22% 0.04 270); color:oklch(80% 0.02 270); padding:14px 28px; border-radius:10px; font-weight:500; font-size:15px; transition:border-color 0.2s, color 0.2s;" onmouseover="this.style.borderColor='oklch(38% 0.04 270)';this.style.color='oklch(94% 0.01 270)'" onmouseout="this.style.borderColor='oklch(22% 0.04 270)';this.style.color='oklch(80% 0.02 270)'">
      Hablar por WhatsApp
    </a>
  </div>

  <!-- Stats -->
  <div class="anim-hero-4" style="position:relative; display:flex; gap:48px; margin-top:80px; padding-top:40px; border-top:1px solid oklch(16% 0.04 270); flex-wrap:wrap; justify-content:center;">
    <div style="text-align:center;">
      <div class="font-syne" style="font-size:28px; font-weight:800; letter-spacing:-0.03em;">9</div>
      <div style="font-size:12px; color:oklch(46% 0.04 270); margin-top:2px; letter-spacing:0.02em;">Apps en producción</div>
    </div>
    <div style="text-align:center;">
      <div class="font-syne" style="font-size:28px; font-weight:800; letter-spacing:-0.03em;">28d</div>
      <div style="font-size:12px; color:oklch(46% 0.04 270); margin-top:2px; letter-spacing:0.02em;">Demo gratis</div>
    </div>
    <div style="text-align:center;">
      <div class="font-syne" style="font-size:28px; font-weight:800; letter-spacing:-0.03em; color:oklch(72% 0.20 145);">IA</div>
      <div style="font-size:12px; color:oklch(46% 0.04 270); margin-top:2px; letter-spacing:0.02em;">Incluida en todas</div>
    </div>
    <div style="text-align:center;">
      <div class="font-syne" style="font-size:28px; font-weight:800; letter-spacing:-0.03em;">🇦🇷</div>
      <div style="font-size:12px; color:oklch(46% 0.04 270); margin-top:2px; letter-spacing:0.02em;">Hecha en Argentina</div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id="como-funciona" style="padding:96px 48px; background:#0c0c14;">
  <div style="max-width:1100px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:68px;">
      <p class="section-label" style="color:oklch(68% 0.22 265);">Proceso</p>
      <h2 class="font-syne" style="font-size:clamp(32px,4vw,52px); font-weight:700; letter-spacing:-0.025em;">Tres pasos y ya estás</h2>
    </div>
    <div class="how-grid">
      <div class="how-col" style="padding:0 48px 0 0; border-right:1px solid oklch(18% 0.04 270);">
        <div class="font-syne" style="font-size:80px; font-weight:800; color:oklch(22% 0.04 270); line-height:1; margin-bottom:24px; letter-spacing:-0.04em;">01</div>
        <h3 class="font-syne" style="font-size:22px; font-weight:700; margin-bottom:12px; letter-spacing:-0.01em;">Elegís la app de tu rubro</h3>
        <p style="color:oklch(50% 0.04 270); line-height:1.75; font-size:15px; font-weight:300;">Buscás la que se adapta a tu negocio, leés las funciones y apretás "Probar 28 días gratis".</p>
      </div>
      <div class="how-col" style="padding:0 48px; border-right:1px solid oklch(18% 0.04 270);">
        <div class="font-syne" style="font-size:80px; font-weight:800; color:oklch(22% 0.04 270); line-height:1; margin-bottom:24px; letter-spacing:-0.04em;">02</div>
        <h3 class="font-syne" style="font-size:22px; font-weight:700; margin-bottom:12px; letter-spacing:-0.01em;">Entrás con tu Gmail</h3>
        <p style="color:oklch(50% 0.04 270); line-height:1.75; font-size:15px; font-weight:300;">Sin usuario ni contraseña nueva. Usás el Google que ya tenés — el acceso demo de 28 días se activa automáticamente.</p>
      </div>
      <div class="how-col" style="padding:0 0 0 48px;">
        <div class="font-syne" style="font-size:80px; font-weight:800; color:oklch(22% 0.04 270); line-height:1; margin-bottom:24px; letter-spacing:-0.04em;">03</div>
        <h3 class="font-syne" style="font-size:22px; font-weight:700; margin-bottom:12px; letter-spacing:-0.01em;">Empezás a usarla</h3>
        <p style="color:oklch(50% 0.04 270); line-height:1.75; font-size:15px; font-weight:300;">Configurás tu negocio en minutos y empezás a operar desde el celular. Sin instalación, sin papeles.</p>
      </div>
    </div>
    <div style="text-align:center; margin-top:56px;">
      <a href="#apps" style="display:inline-block; background:oklch(68% 0.22 265); color:#fff; padding:14px 32px; border-radius:10px; font-weight:600; font-size:15px; transition:background 0.2s;" onmouseover="this.style.background='oklch(72% 0.22 265)'" onmouseout="this.style.background='oklch(68% 0.22 265)'">
        Empezar ahora — es gratis
      </a>
    </div>
  </div>
</section>

<!-- APPS GRID -->
<section id="apps" style="padding:96px 48px; background:#09090f;">
  <div style="max-width:1100px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:64px;">
      <p class="section-label" style="color:oklch(68% 0.22 265);">Apps</p>
      <h2 class="font-syne" style="font-size:clamp(32px,4vw,52px); font-weight:700; letter-spacing:-0.025em; margin-bottom:14px;">Elegí la app de tu rubro</h2>
      <p style="color:oklch(50% 0.04 270); font-size:16px; font-weight:300;">Cada una diseñada específicamente para su sector — con las palabras exactas de ese negocio.</p>
    </div>
    <div class="apps-grid">
      {apps.map(app => (
        <a href={app.href} style={`display:block; background:#111119; border-radius:12px; border-top:3px solid ${app.color}; border-right:1px solid oklch(18% 0.04 270); border-bottom:1px solid oklch(18% 0.04 270); border-left:1px solid oklch(18% 0.04 270); padding:26px 22px 22px; text-decoration:none; transition:background 0.15s;`} onmouseover="this.style.background='#141420'" onmouseout="this.style.background='#111119'">
          <div style="display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:6px;">
            <span class="font-syne" style="font-size:19px; font-weight:700; color:oklch(94% 0.01 270);">{app.name}</span>
            <span style={`font-size:10px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:${app.color}; padding:3px 7px; border-radius:4px; background:oklch(10% 0.01 270); white-space:nowrap; margin-left:8px; margin-top:3px;`}>{app.status}</span>
          </div>
          <p style="color:oklch(48% 0.04 270); font-size:13px; margin-bottom:18px; font-weight:300; line-height:1.5;">{app.subtitle}</p>
          <div style="display:flex; flex-direction:column; gap:7px;">
            {app.features.map(feat => (
              <div style="display:flex; align-items:center; gap:8px; font-size:12px; color:oklch(58% 0.03 270);">
                <span style={`width:4px; height:4px; border-radius:50%; background:${app.color}; flex-shrink:0; display:inline-block; opacity:0.8;`}></span>
                {feat}
              </div>
            ))}
          </div>
          <div style="margin-top:20px; font-size:12px; color:oklch(68% 0.22 265); font-weight:500; letter-spacing:0.01em;">
            {app.cta ?? 'Probar 28 días gratis →'}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- DIFFERENTIATOR -->
<section style="padding:96px 48px; background:#0c0c14;">
  <div style="max-width:1100px; margin:0 auto;" class="diff-two-col">
    <div>
      <p class="section-label" style="color:oklch(72% 0.20 145);">Por qué somos distintos</p>
      <h2 class="font-syne" style="font-size:clamp(28px,3.5vw,46px); font-weight:700; letter-spacing:-0.025em; line-height:1.12; margin-bottom:24px; text-wrap:balance;">
        Hablamos el idioma de tu negocio
      </h2>
      <p style="color:oklch(50% 0.04 270); line-height:1.75; font-size:15px; font-weight:300; margin-bottom:16px;">
        La mayoría de las apps de gestión son horizontales: una sola solución para todos los rubros, con términos genéricos que no encajan del todo con ninguno.
      </p>
      <p style="color:oklch(50% 0.04 270); line-height:1.75; font-size:15px; font-weight:300; margin-bottom:32px;">
        Nosotros hacemos lo opuesto: una app específica para cada rubro, con las palabras, los flujos y los problemas exactos de ese negocio.
      </p>
      <a href="#apps" style="display:inline-block; background:oklch(14% 0.04 270); border:1px solid oklch(25% 0.04 270); color:oklch(80% 0.02 270); padding:12px 22px; border-radius:9px; font-size:14px; font-weight:500; transition:border-color 0.2s, color 0.2s;" onmouseover="this.style.borderColor='oklch(40% 0.04 270)';this.style.color='oklch(94% 0.01 270)'" onmouseout="this.style.borderColor='oklch(25% 0.04 270)';this.style.color='oklch(80% 0.02 270)'">
        Ver todas las apps
      </a>
    </div>
    <div>
      <div class="comparison-grid" style="padding-bottom:12px; margin-bottom:4px; border-bottom:1px solid oklch(20% 0.04 270);">
        <span style="font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:oklch(36% 0.04 270); font-weight:600;">Lo genérico dice</span>
        <span style="font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:oklch(36% 0.04 270); font-weight:600;">Tu rubro dice</span>
      </div>
      {comparisons.map(row => (
        <div class="comparison-grid" style="padding:14px 0; border-bottom:1px solid oklch(14% 0.03 270); align-items:center;">
          <span style="color:oklch(36% 0.04 270); font-size:14px; text-decoration:line-through; font-weight:300; font-style:italic;">{row.generic}</span>
          <div style="display:flex; align-items:center; gap:9px;">
            <span style={`width:7px; height:7px; border-radius:50%; background:${row.color}; flex-shrink:0; display:inline-block;`}></span>
            <div>
              <span style="font-weight:600; font-size:15px; color:oklch(92% 0.01 270);">{row.specific}</span>
              <span style="font-size:11px; color:oklch(44% 0.04 270); margin-left:7px;">· {row.app}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PLATFORM FEATURES -->
<section style="padding:96px 48px; background:#09090f;">
  <div style="max-width:1100px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:64px;">
      <p class="section-label" style="color:oklch(68% 0.22 265);">Plataforma</p>
      <h2 class="font-syne" style="font-size:clamp(32px,4vw,52px); font-weight:700; letter-spacing:-0.025em;">Sin complicaciones</h2>
    </div>
    <div class="feature-grid">
      {platformFeatures.map(f => (
        <div class="feature-cell">
          <div class="font-syne" style="font-size:12px; font-weight:700; color:oklch(68% 0.22 265); letter-spacing:0.06em; margin-bottom:14px;">{f.num}</div>
          <h3 class="font-syne" style="font-size:18px; font-weight:700; margin-bottom:10px; letter-spacing:-0.01em;">{f.title}</h3>
          <p style="color:oklch(50% 0.04 270); font-size:14px; line-height:1.7; font-weight:300;">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section id="opiniones" style="padding:96px 48px; background:#0c0c14;">
  <div style="max-width:1100px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:64px;">
      <p class="section-label" style="color:oklch(68% 0.22 265);">Opiniones</p>
      <h2 class="font-syne" style="font-size:clamp(32px,4vw,52px); font-weight:700; letter-spacing:-0.025em;">Negocios reales, resultados reales</h2>
    </div>
    <div class="testimonials-grid">
      {testimonials.map(t => (
        <div style="background:#111119; border:1px solid oklch(18% 0.04 270); border-radius:14px; padding:32px 28px;">
          <div style={`width:32px; height:3px; background:${t.color}; border-radius:2px; margin-bottom:20px;`}></div>
          <p style="font-size:17px; line-height:1.7; font-weight:300; color:oklch(88% 0.01 270); margin-bottom:24px; font-style:italic;">«{t.quote}»</p>
          <div style="display:flex; align-items:center; gap:12px;">
            <div style={`width:36px; height:36px; border-radius:50%; background:${t.color}; opacity:0.2; flex-shrink:0;`}></div>
            <div>
              <div style="font-weight:600; font-size:14px; color:oklch(90% 0.01 270);">{t.name}</div>
              <div style="font-size:12px; color:oklch(46% 0.04 270);">{t.role}</div>
            </div>
            <div style={`margin-left:auto; font-size:11px; font-weight:600; letter-spacing:0.05em; text-transform:uppercase; color:${t.color}; padding:3px 8px; border-radius:4px; background:oklch(10% 0.01 270);`}>{t.app}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" style="padding:96px 48px; background:#09090f;">
  <div style="max-width:720px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:64px;">
      <p class="section-label" style="color:oklch(68% 0.22 265);">FAQ</p>
      <h2 class="font-syne" style="font-size:clamp(28px,4vw,48px); font-weight:700; letter-spacing:-0.025em;">Preguntas frecuentes</h2>
    </div>
