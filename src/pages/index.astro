<script>
  // Animated word
  const words = ['gremios', 'rutas', 'turnos', 'alumnos', 'comandas', 'socios'];
  let wordIndex = 0;
  const wordEl = document.getElementById('animated-word');
  if (wordEl) {
    setInterval(() => {
      wordIndex = (wordIndex + 1) % words.length;
      wordEl.style.animation = 'none';
      wordEl.offsetHeight; // reflow
      wordEl.textContent = words[wordIndex];
      wordEl.style.animation = 'wordFadeIn 0.55s cubic-bezier(0.22,1,0.36,1) forwards';
    }, 2200);
  }

  // FAQ accordion
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      if (!item) return;
      const answer = item.querySelector('.faq-answer') as HTMLElement;
      const icon = btn.querySelector('.faq-icon');
      const isOpen = answer.style.maxHeight !== '0px' && answer.style.maxHeight !== '';
      // Close all
      document.querySelectorAll('.faq-answer').forEach((a) => {
        (a as HTMLElement).style.maxHeight = '0px';
      });
      document.querySelectorAll('.faq-icon').forEach(ic => { ic.textContent = '+'; });
      document.querySelectorAll('.faq-btn').forEach(b => { (b as HTMLElement).style.background = '#111119'; });
      if (!isOpen) {
        answer.style.maxHeight = '250px';
        if (icon) icon.textContent = '−';
        (btn as HTMLElement).style.background = '#141420';
      }
    });
  });
</script>
