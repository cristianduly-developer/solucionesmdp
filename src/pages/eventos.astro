---
import Layout from '../layouts/Layout.astro';
import AppPage from '../components/AppPage.astro';
---
<Layout title="App Eventos" description="Sistema de reservas para quinchos, salones, SUM y canchas. Calendario, cobros parciales y WhatsApp integrado." navType="app">
  <AppPage
    name="App Eventos"
    tagline="Reservas de espacios sin caos"
    description="Centralizá el calendario, los cobros y los clientes de tu espacio de alquiler en un solo lugar. Desde quinchos y salones hasta canchas de pádel — con WhatsApp integrado, señas y temporadas de precios."
    audience="Quinchos · Salones de fiestas · SUM · Canchas de pádel y fútbol"
    accentColor="oklch(72% 0.18 30)"
    ctaUrl="https://eventos.solucionesmdp.com.ar"
    screenshots={['/screenshots/eventos/calendario.jpg','/screenshots/eventos/turnos.jpg','/screenshots/eventos/detalle-reserva.jpg','/screenshots/eventos/ficha-cliente.jpg']}
    differentiators={['Calendario por espacio y turno','WhatsApp sin API externa','Temporadas de precios','Señas y pagos parciales','Múltiples espacios','Sin instalación (PWA)','Demo 28 días sin tarjeta','White-label con tu logo']}
    features={[
      { title: 'Calendario de disponibilidad', desc: 'Vista mensual por espacio y turno. Detección automática de conflictos por solapamiento real, no por nombre de turno.' },
      { title: 'Múltiples espacios', desc: 'Configurá cada espacio con su nombre, capacidad y turnos propios. Modo fijo (quincho/salón) o slots por hora (canchas).' },
      { title: 'Temporadas de precios', desc: 'Definí "Temporada Alta" con rango de fechas y precio diferenciado semana/finde. Los turnos que no aplican se desactivan automáticamente.' },
      { title: 'WhatsApp integrado', desc: 'Plantillas editables con variables dinámicas. Recordatorio pre-evento y mensaje post-evento. Sin API, usa el WhatsApp de tu celular.' },
      { title: 'Señas y pagos parciales', desc: 'Registrá seña al momento de la reserva y pagos parciales a lo largo del tiempo. Historial de caja y saldo pendiente por reserva.' },
      { title: 'Control de clientes', desc: 'Historial de reservas por cliente, registro de pagos y calificación post-evento para identificar clientes problemáticos.' },
      { title: 'Servicios extras', desc: 'Catálogo de adicionales (catering, decoración, sonido) con precio. Vinculables a cualquier reserva al crearla o editarla.' },
      { title: 'PDFs automáticos', desc: 'Ficha del evento, recibo de pago y reporte con un toque. Todo listo para imprimir o enviar.' },
      { title: 'White-label', desc: 'Tu nombre, logo, ciudad y teléfono en toda la app: login, encabezado, PDFs y mensajes de WhatsApp.' },
    ]}
    plans={[
      { name: 'Básico', features: ['Hasta 50 reservas por mes','1 espacio','Calendario y disponibilidad','Señas y pagos parciales','Gestión de clientes','PDFs automáticos'] },
      { name: 'Profesional', highlight: true, badge: 'Más elegido', features: ['Hasta 100 reservas por mes','Hasta 3 espacios','Todo lo del plan Básico','Recordatorios WhatsApp','Servicios extras','1 colaborador'] },
      { name: 'Premium', features: ['Reservas ilimitadas','Hasta 5 espacios','Todo lo del plan Profesional','Temporadas de precios avanzadas','3 colaboradores','Soporte prioritario'] },
    ]}
  />
</Layout>
