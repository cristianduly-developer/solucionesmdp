---
import Layout from '../layouts/Layout.astro';

const WA = 'https://wa.me/542236965481';
const acc = 'oklch(72% 0.20 145)';

const includes = [
  'Diseño a medida — nada de templates genéricos',
  'Mobile first — perfecto en celular y desktop',
  'Dominio .com.ar — primer año incluido',
  'Hosting y publicación — vos no hacés nada técnico',
  'SEO básico — para que Google te encuentre',
  'WhatsApp flotante — contacto directo en toda la web',
  'HTTPS — el candadito verde que da confianza',
];

const pasos = [
  { n: '01', title: 'Nos contás qué necesitás', desc: 'Rubro, servicios, fotos que tenés y colores que te gustan. Por WhatsApp, sin formularios.' },
  { n: '02', title: 'Te armamos un boceto', desc: 'En 48 horas te mostramos el diseño. Lo ajustamos hasta que quede exactamente como querés.' },
  { n: '03', title: 'Lo aprobás', desc: 'Revisás cada sección y nos confirmás cuando está listo para publicar.' },
  { n: '04', title: 'Lo publicamos', desc: 'Subimos todo y en minutos tu negocio tiene presencia online profesional.' },
];

const tipos = [
  { icon: '💇', rubro: 'Estética y belleza', ejemplo: 'Galería de trabajos, servicios con precios y turno por WhatsApp.' },
  { icon: '🔧', rubro: 'Oficios y construcción', ejemplo: 'Portfolio de obras, zona de cobertura y formulario de presupuesto.' },
  { icon: '🍽️', rubro: 'Gastronomía', ejemplo: 'Carta digital, horarios, local en mapa y reserva online.' },
  { icon: '📚', rubro: 'Profesionales', ejemplo: 'Presentación, servicios, honorarios y formulario de consulta.' },
  { icon: '🏪', rubro: 'Comercios', ejemplo: 'Catálogo de productos con precios y link directo a WhatsApp.' },
  { icon: '🏟️', rubro: 'Espacios y eventos', ejemplo: 'Galería, disponibilidad, precios por temporada y reserva.' },
];

const basicFeatures = ['1 página larga','Diseño personalizado','Dominio .com.ar','Hosting 1 año','WhatsApp integrado','Formulario de contacto'];
const completeFeatures = ['Hasta 5 páginas','Todo lo de Landing','Galería de fotos','Sección de testimonios','Blog o novedades','SEO avanzado'];
const maintFeatures = ['Cambios ilimitados','Actualización de contenido','Renovación del hosting','Soporte técnico','Copias de seguridad','Asesoramiento mensual'];
---
<Layout title="Diseño Web" description="Diseñamos y publicamos el sitio de tu negocio en menos de una semana. Dominio .com.ar, mobile-first y optimizado para Google." navType="app">

  <!-- HERO -->
  <section style="min-height:100vh;display:flex;align-items:center;padding:100px 48px 80px;position:relative;overflow:hidden;">
    <div style={`position:absolute;inset:0;background:radial-gradient(ellipse 55% 55% at 65% 40%,oklch(20% 0.12 145 / 0.20) 0%,transparent 65%);pointer-events:none;`}></div>
    <div style="position:absolute;inset:0;background-image:radial-gradient(oklch(28% 0.04 270 / 0.3) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;"></div>
    <div class="web-hero-grid" style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;width:100%;">

      <!-- Left -->
      <div>
        <div style={`display:inline-flex;align-items:center;padding:6px 14px;border:1px solid ${acc};border-radius:100px;margin-bottom:18px;font-size:13px;color:${acc};background:oklch(72% 0.20 145 / 0.08);font-weight:500;`}>
          Diseño web · A medida · Mar del Plata
        </div>
        <h1 class="font-syne" style="font-size:clamp(40px,5.5vw,72px);font-weight:800;line-height:1.04;letter-spacing:-0.032em;margin-bottom:12px;">
          Web para tu<br /><span style={`color:${acc};`}>negocio</span>
        </h1>
        <p style="color:oklch(52% 0.04 270);font-size:16px;line-height:1.75;font-weight:300;margin-bottom:36px;max-width:460px;">
          Diseñamos y publicamos el sitio de tu negocio en menos de una semana. Con dominio .com.ar propio, optimizado para celular y listo para que Google te encuentre.
        </p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
          <a href={WA} target="_blank" style={`display:inline-block;background:${acc};color:#052010;padding:14px 28px;border-radius:10px;font-weight:600;font-size:15px;`}>
            Consultar por WhatsApp →
          </a>
          <a href="#precios" style="background:oklch(13% 0.04 270);border:1px solid oklch(22% 0.04 270);color:oklch(78% 0.02 270);padding:14px 24px;border-radius:10px;font-weight:500;font-size:15px;">
            Ver precios
          </a>
        </div>
        <p style="font-size:12px;color:oklch(36% 0.04 270);letter-spacing:0.02em;">Presupuesto sin cargo · Respuesta en el día</p>
      </div>

      <!-- Right: included card -->
      <div style={`background:#111119;border:1px solid oklch(72% 0.20 145 / 0.18);border-radius:16px;padding:28px 26px;box-shadow:0 0 60px oklch(72% 0.20 145 / 0.06);`}>
        <p style={`font-size:11px;font-weight:700;color:${acc};text-transform:uppercase;letter-spacing:0.1em;margin-bottom:20px;`}>Incluido en todos los planes</p>
        <div style="display:flex;flex-direction:column;gap:14px;">
          {includes.map(item => (
            <div style="display:flex;align-items:center;gap:12px;">
              <span style={`color:${acc};font-weight:700;font-size:13px;flex-shrink:0;`}>✓</span>
              <span style="font-size:14px;color:oklch(76% 0.02 270);font-weight:300;">{item}</span>
            </div>
          ))}
        </div>
        <div style="margin-top:24px;padding-top:20px;border-top:1px solid oklch(18% 0.04 270);display:flex;justify-content:space-between;">
          <div>
            <p style="font-size:11px;color:oklch(40% 0.04 270);margin-bottom:2px;">Entrega estimada</p>
            <p style="font-weight:600;font-size:15px;">5 a 7 días hábiles</p>
          </div>
          <div style="text-align:right;">
            <p style="font-size:11px;color:oklch(40% 0.04 270);margin-bottom:2px;">Presupuesto</p>
            <p style={`font-weight:600;font-size:15px;color:${acc};`}>Sin cargo</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- PROCESO -->
  <section style="padding:96px 48px;background:#0c0c14;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:60px;">
        <p style={`font-size:12px;text-transform:uppercase;letter-spacing:0.1em;color:${acc};font-weight:600;margin-bottom:14px;`}>Proceso</p>
        <h2 class="font-syne" style="font-size:clamp(28px,4vw,48px);font-weight:700;letter-spacing:-0.025em;">De cero a publicada en una semana</h2>
      </div>
      <div class="proceso-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;">
        {pasos.map(p => (
          <div style="background:#111119;border:1px solid oklch(18% 0.04 270);border-radius:12px;padding:24px 20px;">
            <div class="font-syne" style={`font-size:12px;font-weight:700;color:${acc};letter-spacing:0.06em;margin-bottom:14px;`}>{p.n}</div>
            <h3 class="font-syne" style="font-size:16px;font-weight:700;margin-bottom:8px;letter-spacing:-0.01em;line-height:1.3;">{p.title}</h3>
            <p style="color:oklch(48% 0.04 270);font-size:13px;line-height:1.65;font-weight:300;">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PARA QUIÉN -->
  <section style="padding:96px 48px;background:#09090f;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:60px;">
        <p style={`font-size:12px;text-transform:uppercase;letter-spacing:0.1em;color:${acc};font-weight:600;margin-bottom:14px;`}>Para quién</p>
        <h2 class="font-syne" style="font-size:clamp(28px,4vw,48px);font-weight:700;letter-spacing:-0.025em;margin-bottom:12px;">Para cualquier tipo de negocio</h2>
        <p style="color:oklch(50% 0.04 270);font-weight:300;">Si tenés clientes, necesitás que te encuentren online.</p>
      </div>
      <div class="tipos-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
        {tipos.map(t => (
          <div style="background:#111119;border:1px solid oklch(18% 0.04 270);border-radius:12px;padding:22px 20px;display:flex;gap:14px;align-items:flex-start;">
            <div style={`width:36px;height:36px;border-radius:8px;background:oklch(72% 0.20 145 / 0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;`}>{t.icon}</div>
            <div>
              <h3 class="font-syne" style="font-size:15px;font-weight:700;margin-bottom:5px;">{t.rubro}</h3>
              <p style="font-size:13px;color:oklch(48% 0.04 270);font-weight:300;line-height:1.55;">{t.ejemplo}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRECIOS -->
  <section id="precios" style="padding:96px 48px;background:#0c0c14;">
    <div style="max-width:960px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:60px;">
        <p style={`font-size:12px;text-transform:uppercase;letter-spacing:0.1em;color:${acc};font-weight:600;margin-bottom:14px;`}>Precios</p>
        <h2 class="font-syne" style="font-size:clamp(28px,4vw,48px);font-weight:700;letter-spacing:-0.025em;margin-bottom:12px;">Precio fijo, sin sorpresas</h2>
        <p style="color:oklch(50% 0.04 270);font-weight:300;">Mantenimiento opcional por separado.</p>
      </div>
      <div class="plans-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;">

        <!-- Landing básica -->
        <div style="position:relative;background:#111119;border-radius:14px;padding:28px 22px;border:1px solid oklch(18% 0.04 270);">
          <h3 class="font-syne" style="font-size:21px;font-weight:700;margin-bottom:4px;">Landing básica</h3>
          <p style={`font-size:18px;font-weight:700;color:${acc};margin-bottom:6px;`}>Desde $150.000</p>
          <p style="font-size:13px;color:oklch(44% 0.04 270);margin-bottom:20px;font-weight:300;line-height:1.5;">Una página completa. Ideal para presentar tu negocio y que te contacten.</p>
          <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:24px;">
            {basicFeatures.map(f => (
              <div style="display:flex;align-items:flex-start;gap:8px;font-size:13px;color:oklch(58% 0.03 270);line-height:1.45;">
                <span style={`color:${acc};font-weight:700;font-size:12px;flex-shrink:0;margin-top:2px;`}>✓</span>
                {f}
              </div>
            ))}
          </div>
          <a href={WA} target="_blank" style="display:block;text-align:center;font-weight:500;padding:12px;border-radius:9px;border:1px solid oklch(24% 0.04 270);color:oklch(58% 0.03 270);font-size:14px;text-decoration:none;">
            Consultar precio exacto →
          </a>
        </div>

        <!-- Sitio completo -->
        <div style={`position:relative;background:#111119;border-radius:14px;padding:28px 22px;border:2px solid oklch(72% 0.20 145 / 0.40);`}>
          <div style={`position:absolute;top:-12px;left:50%;transform:translateX(-50%);font-size:11px;font-weight:700;padding:3px 12px;border-radius:100px;background:${acc};color:#052010;white-space:nowrap;letter-spacing:0.04em;`}>
            Más elegido
          </div>
          <h3 class="font-syne" style="font-size:21px;font-weight:700;margin-bottom:4px;">Sitio completo</h3>
          <p style={`font-size:18px;font-weight:700;color:${acc};margin-bottom:6px;`}>Desde $280.000</p>
          <p style="font-size:13px;color:oklch(44% 0.04 270);margin-bottom:20px;font-weight:300;line-height:1.5;">Varias secciones o páginas. Portfolio, galería, testimonios y contacto.</p>
          <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:24px;">
            {completeFeatures.map(f => (
              <div style="display:flex;align-items:flex-start;gap:8px;font-size:13px;color:oklch(58% 0.03 270);line-height:1.45;">
                <span style={`color:${acc};font-weight:700;font-size:12px;flex-shrink:0;margin-top:2px;`}>✓</span>
                {f}
              </div>
            ))}
          </div>
          <a href={WA} target="_blank" style={`display:block;text-align:center;font-weight:600;padding:13px;border-radius:9px;background:${acc};color:#052010;font-size:14px;text-decoration:none;`}>
            Consultar precio exacto →
          </a>
        </div>

        <!-- Mantenimiento -->
        <div style="position:relative;background:#111119;border-radius:14px;padding:28px 22px;border:1px solid oklch(18% 0.04 270);">
          <h3 class="font-syne" style="font-size:21px;font-weight:700;margin-bottom:4px;">Mantenimiento</h3>
          <p style={`font-size:18px;font-weight:700;color:${acc};margin-bottom:6px;`}>Desde $30.000/mes</p>
          <p style="font-size:13px;color:oklch(44% 0.04 270);margin-bottom:20px;font-weight:300;line-height:1.5;">Actualizaciones de fotos, precios, textos o nuevas secciones cuando lo necesitás.</p>
          <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:24px;">
            {maintFeatures.map(f => (
              <div style="display:flex;align-items:flex-start;gap:8px;font-size:13px;color:oklch(58% 0.03 270);line-height:1.45;">
                <span style={`color:${acc};font-weight:700;font-size:12px;flex-shrink:0;margin-top:2px;`}>✓</span>
                {f}
              </div>
            ))}
          </div>
          <a href={WA} target="_blank" style="display:block;text-align:center;font-weight:500;padding:12px;border-radius:9px;border:1px solid oklch(24% 0.04 270);color:oklch(58% 0.03 270);font-size:14px;text-decoration:none;">
            Consultar precio exacto →
          </a>
        </div>

      </div>
      <p style="text-align:center;color:oklch(36% 0.04 270);font-size:13px;margin-top:28px;">
        ¿Necesitás algo diferente? <a href={WA} target="_blank" style="color:oklch(50% 0.04 270);">Hablamos y lo armamos a medida</a>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding:96px 48px;background:#09090f;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 60% at 50% 50%,oklch(18% 0.10 145 / 0.28) 0%,transparent 70%);pointer-events:none;"></div>
    <div style="position:relative;max-width:560px;margin:0 auto;">
      <h2 class="font-syne" style="font-size:clamp(28px,4vw,48px);font-weight:800;letter-spacing:-0.03em;margin-bottom:14px;line-height:1.1;">¿Arrancamos?</h2>
      <p style="color:oklch(50% 0.04 270);font-size:16px;font-weight:300;margin-bottom:36px;line-height:1.75;">
        Contanos qué necesitás y en el día te mandamos un presupuesto sin cargo.
      </p>
      <a href={WA} target="_blank" style={`display:inline-block;background:${acc};color:#052010;padding:15px 32px;border-radius:10px;font-weight:600;font-size:15px;`}>
        Consultar por WhatsApp →
      </a>
    </div>
  </section>

</Layout>

<style>
  @media (max-width: 860px) {
    .web-hero-grid { grid-template-columns: 1fr !important; }
    .proceso-grid  { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 640px) {
    .tipos-grid   { grid-template-columns: 1fr !important; }
    .plans-grid   { grid-template-columns: 1fr !important; }
    .proceso-grid { grid-template-columns: 1fr !important; }
  }
</style>
