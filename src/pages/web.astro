---
import Layout from '../layouts/Layout.astro';

const WA = 'https://wa.me/542236965481?text=Hola!%20Me%20interesa%20el%20servicio%20de%20diseño%20web';

const pasos = [
  { n: '01', title: 'Nos contás qué necesitás', desc: 'Rubro, servicios, fotos que tenés y colores que te gustan. Por WhatsApp, sin formularios.' },
  { n: '02', title: 'Te armamos un boceto', desc: 'En 48 horas te mostramos el diseño. Lo ajustamos hasta que quede exactamente como querés.' },
  { n: '03', title: 'Lo aprobás', desc: 'Revisás cada sección y nos confirmás cuando está listo para publicar.' },
  { n: '04', title: 'Lo publicamos', desc: 'Subimos todo y en minutos tu negocio tiene presencia online.' },
];

const tipos = [
  { rubro: 'Estética y belleza', ejemplo: 'Galería de trabajos, servicios con precios y turno por WhatsApp.' },
  { rubro: 'Oficios y construcción', ejemplo: 'Portfolio de obras, zona de cobertura y formulario de presupuesto.' },
  { rubro: 'Gastronomía', ejemplo: 'Carta digital, horarios, local en mapa y reserva online.' },
  { rubro: 'Profesionales', ejemplo: 'Presentación, servicios, honorarios y formulario de consulta.' },
  { rubro: 'Comercios', ejemplo: 'Catálogo de productos con precios y link directo a WhatsApp.' },
  { rubro: 'Espacios y eventos', ejemplo: 'Galería, disponibilidad, precios por temporada y reserva.' },
];

const incluido = [
  'Diseño a medida — nada de templates genéricos',
  'Mobile first — perfecto en celular y desktop',
  'Dominio .com.ar — primer año incluido',
  'Hosting y publicación — vos no hacés nada técnico',
  'SEO básico — para que Google te encuentre',
  'WhatsApp flotante — contacto directo en toda la web',
  'HTTPS — el candadito verde que da confianza',
];
---

<Layout
  title="Diseño de Páginas Web para Negocios"
  description="Diseño web a medida para negocios en Mar del Plata y Argentina. Página profesional con dominio .com.ar, optimizada para celular, lista en 5 a 7 días."
  keywords="diseño web mar del plata, página web negocio, diseño web argentina, landing page negocio, web para pymes"
  schema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Diseño Web - Soluciones MDP",
    provider: { "@type": "Organization", name: "Soluciones MDP" },
    areaServed: { "@type": "City", name: "Mar del Plata" },
    description: "Diseño y publicación de sitios web a medida para negocios.",
  }}
>

  <!-- ═══ HERO ═══ -->
  <section class="hero-glow dot-grid relative min-h-[85vh] flex items-center">
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-28 md:py-36 w-full">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">

        <div>
          <a href="/" class="anim-1 inline-flex items-center gap-1.5 text-[13px] mb-6 transition-colors" style="color: var(--text-faint);">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
            Volver al portfolio
          </a>

          <div class="anim-2 mb-4">
            <span class="chip">Servicio de diseño web</span>
          </div>

          <h1 class="anim-3 headline text-[clamp(36px,5.5vw,56px)] mb-4">
            Web para tu<br/>
            <span class="gradient-text">negocio</span>
          </h1>

          <p class="anim-4 text-[15px] leading-relaxed mb-8 max-w-md" style="color: var(--text-muted);">
            Diseñamos y publicamos el sitio de tu negocio en menos de una semana. Con dominio .com.ar propio, optimizado para celular y listo para que Google te encuentre.
          </p>

          <div class="anim-5 flex flex-col sm:flex-row gap-3 mb-4">
            <a href={WA} target="_blank" class="btn-primary py-2.5 px-6">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Consultar por WhatsApp
            </a>
            <a href="#precios" class="btn-ghost py-2.5 px-6">
              Ver precios
            </a>
          </div>
          <p class="anim-5 text-[12px]" style="color: var(--text-faint);">Presupuesto sin cargo · Respuesta en el día</p>
        </div>

        <!-- Card incluido -->
        <div class="anim-5 card p-7">
          <p class="text-[12px] font-semibold tracking-widest uppercase mb-5" style="color: var(--accent);">Incluido en todos los planes</p>
          <div class="flex flex-col gap-3.5">
            {incluido.map(item => (
              <div class="flex items-center gap-3">
                <svg class="w-3.5 h-3.5 flex-shrink-0" style="color: var(--accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-[13px]" style="color: var(--text-muted);">{item}</span>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-5 flex items-center justify-between" style="border-top: 1px solid var(--border);">
            <div>
              <p class="text-[11px]" style="color: var(--text-faint);">Entrega estimada</p>
              <p class="text-[14px] font-semibold" style="color: var(--text);">5 a 7 días hábiles</p>
            </div>
            <div class="text-right">
              <p class="text-[11px]" style="color: var(--text-faint);">Presupuesto</p>
              <p class="text-[14px] font-semibold" style="color: var(--accent);">Sin cargo</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══ PROCESO ═══ -->
  <section class="section-alt">
    <div class="max-w-[1200px] mx-auto px-6 py-20 md:py-24">
      <div class="reveal mb-14">
        <p class="text-[12px] font-semibold tracking-widest uppercase mb-3" style="color: var(--accent);">Proceso</p>
        <h2 class="headline text-[clamp(24px,3.5vw,36px)] mb-3">De cero a publicada en una semana</h2>
      </div>
      <div class="grid md:grid-cols-4 gap-4">
        {pasos.map((p, i) => (
          <div class={`reveal reveal-d${i+1} card p-5 relative`}>
            <span class="absolute top-4 right-4 text-[40px] font-bold leading-none" style="color: rgba(255,255,255,0.03);">{p.n}</span>
            <h3 class="text-[14px] font-semibold mb-2" style="color: var(--text);">{p.title}</h3>
            <p class="text-[13px] leading-relaxed" style="color: var(--text-muted);">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ RUBROS ═══ -->
  <section class="max-w-[1200px] mx-auto px-6 py-20 md:py-24">
    <div class="reveal mb-14">
      <p class="text-[12px] font-semibold tracking-widest uppercase mb-3" style="color: var(--accent);">Rubros</p>
      <h2 class="headline text-[clamp(24px,3.5vw,36px)] mb-3">Para cualquier tipo de negocio</h2>
      <p class="text-[15px] max-w-lg" style="color: var(--text-muted);">Si tenés clientes, necesitás que te encuentren online.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {tipos.map((t, i) => (
        <div class={`reveal reveal-d${(i % 6)+1} card p-5`}>
          <h3 class="text-[14px] font-semibold mb-1.5" style="color: var(--text);">{t.rubro}</h3>
          <p class="text-[13px] leading-relaxed" style="color: var(--text-muted);">{t.ejemplo}</p>
        </div>
      ))}
    </div>
  </section>


  <!-- ═══ PRECIOS ═══ -->
  <section id="precios" class="section-alt">
    <div class="max-w-[1000px] mx-auto px-6 py-20 md:py-24">
      <div class="reveal mb-14 text-center">
        <p class="text-[12px] font-semibold tracking-widest uppercase mb-3" style="color: var(--accent);">Precios</p>
        <h2 class="headline text-[clamp(24px,3.5vw,36px)] mb-3">Precio fijo, sin sorpresas</h2>
        <p class="text-[15px]" style="color: var(--text-muted);">Mantenimiento opcional.</p>
      </div>
      <div class="reveal grid md:grid-cols-3 gap-4">
        {[
          {
            name: 'Landing básica',
            price: 'Desde $150.000',
            desc: 'Una página completa. Ideal para presentar tu negocio y que te contacten.',
            features: ['1 página larga', 'Diseño personalizado', 'Dominio .com.ar', 'Hosting 1 año', 'WhatsApp integrado', 'Formulario de contacto'],
            highlight: false,
          },
          {
            name: 'Sitio completo',
            price: 'Desde $280.000',
            desc: 'Varias secciones o páginas. Portfolio, galería, testimonios y contacto.',
            features: ['Hasta 5 páginas', 'Todo lo de Landing', 'Galería de fotos', 'Sección de testimonios', 'Blog o novedades', 'SEO avanzado'],
            highlight: true,
            badge: 'Más elegido',
          },
          {
            name: 'Mantenimiento',
            price: 'Desde $30.000/mes',
            desc: 'Actualizaciones de fotos, precios, textos o nuevas secciones.',
            features: ['Cambios ilimitados', 'Actualización de contenido', 'Renovación del hosting', 'Soporte técnico', 'Copias de seguridad', 'Asesoramiento mensual'],
            highlight: false,
          },
        ].map(plan => (
          <div class={`card-static p-6 relative ${plan.highlight ? '' : ''}`} style={plan.highlight ? 'border-color: var(--accent); border-width: 2px;' : ''}>
            {plan.badge && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 text-[11px] font-semibold px-3 py-1 rounded-full whitespace-nowrap" style="background: var(--accent); color: white;">
                {plan.badge}
              </div>
            )}
            <h3 class="text-[17px] font-semibold mb-1" style="color: var(--text);">{plan.name}</h3>
            <p class="text-[16px] font-semibold mb-1" style={`color: ${plan.highlight ? 'var(--accent)' : 'var(--text-muted)'};`}>{plan.price}</p>
            <p class="text-[13px] mb-5 leading-relaxed" style="color: var(--text-faint);">{plan.desc}</p>
            <div class="flex flex-col gap-2.5 mb-6">
              {plan.features.map(f => (
                <div class="flex items-start gap-2 text-[13px]" style="color: var(--text-muted);">
                  <svg class="w-3.5 h-3.5 mt-0.5 flex-shrink-0" style="color: var(--accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  {f}
                </div>
              ))}
            </div>
            <a href={WA} target="_blank"
              class={plan.highlight ? 'btn-primary w-full py-2.5 text-[13px]' : 'btn-ghost w-full py-2.5 text-[13px]'}>
              Consultar precio exacto
            </a>
          </div>
        ))}
      </div>
      <p class="text-center text-[13px] mt-8" style="color: var(--text-faint);">
        ¿Necesitás algo diferente?
        <a href={WA} target="_blank" class="ml-1 transition-colors" style="color: var(--text-muted);">Hablamos y lo armamos a medida</a>
      </p>
    </div>
  </section>


  <!-- ═══ CTA ═══ -->
  <section class="relative overflow-hidden">
    <div class="hero-glow">
      <div class="relative z-10 max-w-3xl mx-auto px-6 py-20 md:py-28 text-center">
        <div class="reveal">
          <h2 class="headline text-[clamp(24px,4vw,40px)] mb-4">
            ¿Arrancamos con<br/>
            <span class="gradient-text">tu página web?</span>
          </h2>
          <p class="text-[15px] max-w-md mx-auto mb-8" style="color: var(--text-muted);">
            Contanos qué necesitás y en el día te mandamos un presupuesto sin cargo.
          </p>
          <a href={WA} target="_blank" class="btn-primary py-3 px-7 text-[15px]">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
