---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Mi Negocio Digital"
  description="Activo digital creado con Soluciones MDP"
>

<section id="loading" class="min-h-[calc(100vh-4rem)] flex items-center justify-center">
  <div class="text-center">
    <div class="w-12 h-12 mx-auto mb-4 border-2 border-cyan-500/20 border-t-cyan-400 rounded-full animate-spin"></div>
    <p class="text-slate-400">Cargando...</p>
  </div>
</section>

<section id="content-section" class="hidden py-12 px-4">
  <div class="max-w-lg mx-auto">
    <div class="text-center mb-8">
      <p id="n-tipo" class="text-xs text-cyan-400 uppercase tracking-wider mb-2"></p>
      <h1 id="n-nombre" class="text-2xl font-bold text-white mb-1"></h1>
      <p id="n-descripcion" class="text-slate-400 text-sm"></p>
      <div id="n-info" class="flex justify-center gap-4 mt-3 text-xs text-slate-500"></div>
    </div>
    <div id="n-items" class="space-y-2"></div>
    <div class="mt-12 pt-6 border-t border-white/5 text-center">
      <p class="text-xs text-slate-600 mb-2">Creado con</p>
      <a href="https://www.solucionesmdp.com.ar" target="_blank" class="inline-flex items-center gap-2 text-sm text-cyan-500 hover:text-cyan-400 transition-colors">
        <img src="/logo.png" alt="Soluciones MDP" class="h-8 w-auto opacity-60" />
        <span class="font-semibold">Soluciones MDP</span>
      </a>
      <p class="text-xs text-slate-600 mt-2">
        <a href="https://www.solucionesmdp.com.ar/gemelo-digital" class="text-cyan-600 hover:underline">Creá el tuyo gratis</a>
      </p>
    </div>
  </div>
</section>

<section id="error-section" class="hidden min-h-[calc(100vh-4rem)] flex items-center justify-center px-4">
  <div class="text-center">
    <p class="text-2xl mb-2">😕</p>
    <h2 class="text-xl font-bold text-white mb-2">No encontrado</h2>
    <p class="text-slate-400">Este link puede haber expirado.</p>
    <a href="https://www.solucionesmdp.com.ar/gemelo-digital" class="inline-block mt-4 px-6 py-2 rounded-lg bg-cyan-600 text-white font-medium text-sm">Crear mi gemelo digital gratis</a>
  </div>
</section>

</Layout>

<script>
const SB_URL = 'https://ngymvfvlknaltsvsrvjm.supabase.co';
const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5neW12ZnZsa25hbHRzdnNydmptIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzkyMTMxNDYsImV4cCI6MjA1NDc4OTE0Nn0.HSjgnABBbTnKQSMkrBpYkXZBeKNGxL4Yb5LEjWmHhbA';

const TIPO_LABELS = {
  turnos: 'Sistema de Turnos',
  quincho: 'Sistema de Reservas',
  membresias: 'Membresías y Actividades',
  reparto: 'Catálogo de Delivery',
  presup: 'Presupuesto Digital',
  contratista: 'Gestión de Obra',
  docentes: 'Tarjeta Digital Profesional',
};

async function init() {
  const params = new URLSearchParams(window.location.search);
  const slug = params.get('s') || params.get('slug');
  if (!slug) { showError(); return; }

  try {
    fetch(`${SB_URL}/rest/v1/rpc/increment_gemelo_visitas`, {
      method: 'POST',
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug_param: slug }),
    }).catch(() => {});

    const res = await fetch(`${SB_URL}/rest/v1/gemelos_digitales?slug=eq.${slug}&select=*`, {
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}` },
    });
    const data = await res.json();
    if (!data?.length) { showError(); return; }

    const g = data[0];
    if (g.preview_type === 'gastro') {
      window.location.href = `/mi/menu?s=${slug}`;
      return;
    }
    render(g);
  } catch (e) { showError(); }
}

function render(g) {
  document.getElementById('loading').classList.add('hidden');
  document.getElementById('content-section').classList.remove('hidden');

  const type = g.preview_type || g.app_id;
  document.getElementById('n-tipo').textContent = TIPO_LABELS[type] || 'Tu Negocio Digital';
  document.getElementById('n-nombre').textContent = g.nombre || 'Mi Negocio';
  document.getElementById('n-descripcion').textContent = g.descripcion || '';
  document.title = `${g.nombre || 'Mi Negocio'} — ${TIPO_LABELS[type] || 'Digital'}`;

  const info = document.getElementById('n-info');
  const parts = [];
  if (g.horarios && g.horarios !== 'Consultar') parts.push(`🕐 ${g.horarios}`);
  if (g.direccion) parts.push(`📍 ${g.direccion}`);
  if (g.redes?.instagram) parts.push(`📸 ${g.redes.instagram}`);
  info.innerHTML = parts.map(p => `<span>${p}</span>`).join('');

  const container = document.getElementById('n-items');
  const items = g.items;

  if (type === 'turnos') {
    container.innerHTML = (items || []).map(it => {
      const precio = Number(it.precio);
      return `<div class="flex items-center justify-between p-4 rounded-xl bg-white/5 border border-white/10">
        <div><p class="text-sm font-medium text-white">${it.nombre}</p><p class="text-xs text-slate-400">${it.duracion_min || 30} min</p></div>
        <div class="text-right">
          ${!isNaN(precio) && precio > 0 ? `<p class="text-white font-medium">$${precio.toLocaleString('es-AR')}</p>` : ''}
          <button class="text-xs text-cyan-400 mt-0.5">Reservar →</button>
        </div>
      </div>`;
    }).join('');
  } else if (type === 'quincho') {
    container.innerHTML = (items || []).map(it => {
      const precio = Number(it.precio);
      return `<div class="flex items-center justify-between p-4 rounded-xl bg-white/5 border border-white/10">
        <div><p class="text-sm font-medium text-white">${it.nombre}</p><p class="text-xs text-slate-400">${it.turno || ''}</p></div>
        ${!isNaN(precio) && precio > 0 ? `<p class="text-white font-medium">$${precio.toLocaleString('es-AR')}</p>` : '<button class="text-xs text-cyan-400">Reservar →</button>'}
      </div>`;
    }).join('');
  } else if (type === 'membresias') {
    container.innerHTML = (items || []).map(it => {
      const precio = Number(it.precio_mensual);
      return `<div class="flex items-center justify-between p-4 rounded-xl bg-white/5 border border-white/10">
        <div><p class="text-sm font-medium text-white">${it.nombre}</p><p class="text-xs text-slate-400">${it.frecuencia || ''}</p></div>
        ${!isNaN(precio) && precio > 0 ? `<p class="text-white font-medium">$${precio.toLocaleString('es-AR')}/mes</p>` : ''}
      </div>`;
    }).join('');
  } else if (type === 'reparto') {
    container.innerHTML = (items || []).map(it => {
      const precio = Number(it.precio);
      return `<div class="flex items-center justify-between p-4 rounded-xl bg-white/5 border border-white/10">
        <span class="text-sm text-white">${it.nombre}</span>
        ${!isNaN(precio) && precio > 0 ? `<span class="text-white font-medium">$${precio.toLocaleString('es-AR')} ${it.unidad ? '/ ' + it.unidad : ''}</span>` : ''}
      </div>`;
    }).join('');
  } else if (type === 'presup') {
    const total = (items || []).reduce((s, it) => s + (it.cantidad || 1) * (it.precio_unitario || 0), 0);
    container.innerHTML = `
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-slate-400 border-b border-white/10">
            <th class="text-left py-2">Descripción</th><th class="text-right py-2">Cant.</th><th class="text-right py-2">P.Unit.</th><th class="text-right py-2">Subtotal</th>
          </tr></thead>
          <tbody>${(items || []).map(it => `
            <tr class="border-b border-white/5">
              <td class="py-2 text-slate-300">${it.descripcion}</td>
              <td class="py-2 text-right text-slate-400">${it.cantidad || 1}</td>
              <td class="py-2 text-right text-slate-400">$${Number(it.precio_unitario || 0).toLocaleString('es-AR')}</td>
              <td class="py-2 text-right text-white font-medium">$${((it.cantidad || 1) * (it.precio_unitario || 0)).toLocaleString('es-AR')}</td>
            </tr>`).join('')}
          </tbody>
          <tfoot><tr class="border-t border-white/20">
            <td colspan="3" class="py-3 text-right font-semibold text-slate-300">TOTAL</td>
            <td class="py-3 text-right text-lg font-bold text-cyan-400">$${total.toLocaleString('es-AR')}</td>
          </tr></tfoot>
        </table>
      </div>`;
  } else if (type === 'contratista' && items?.nombre_obra) {
    container.innerHTML = `
      <h2 class="text-lg font-bold text-white mb-4">${items.nombre_obra}</h2>
      <div class="space-y-2 mb-4">${(items.gremios || []).map(g => `
        <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
          <span class="text-sm text-white">${g.nombre}</span>
          <span class="text-white font-medium">$${Number(g.monto || 0).toLocaleString('es-AR')}</span>
        </div>`).join('')}
      </div>
      <div class="flex justify-between items-center pt-3 border-t border-white/20">
        <span class="font-semibold text-slate-300">Total obra</span>
        <span class="text-lg font-bold text-cyan-400">$${Number(items.monto_total || 0).toLocaleString('es-AR')}</span>
      </div>`;
  } else if (type === 'docentes') {
    const t = items || {};
    container.innerHTML = `
      <div class="max-w-sm mx-auto rounded-xl border border-white/10 bg-gradient-to-br from-green-500/10 to-emerald-500/5 p-8 text-center">
        <h2 class="text-xl font-bold text-white mb-1">${g.nombre || ''}</h2>
        <p class="text-sm text-slate-400 mb-4">${t.slogan || ''}</p>
        ${(t.servicios || []).length ? `<div class="flex flex-wrap justify-center gap-2 mb-4">${t.servicios.map(s => `<span class="px-3 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-xs text-green-300">${s}</span>`).join('')}</div>` : ''}
        <p class="text-xs text-slate-400">${t.horarios || ''}</p>
      </div>`;
  }
}

function showError() {
  document.getElementById('loading').classList.add('hidden');
  document.getElementById('error-section').classList.remove('hidden');
}

init();
</script>
