---
import Layout from '../layouts/Layout.astro';
import AppPage from '../components/AppPage.astro';
---
<Layout title="App Reparto" description="Gestión de reparto a domicilio sin papel ni Excel. Pedidos, rutas, stock y cobros — incluso sin internet." navType="app">
  <AppPage
    name="App Reparto"
    tagline="Gestioná tu reparto sin papel ni Excel"
    description="Pedidos, rutas, stock y cobros en un solo lugar — incluso sin internet. Para distribuidores y negocios que salen a repartir todos los días y necesitan orden sin complicaciones."
    audience="Distribuidores de agua · Almacenes · Verdulerías · Panaderías"
    accentColor="oklch(65% 0.20 220)"
    ctaUrl="https://reparto.solucionesmdp.com.ar"
    screenshots={['/screenshots/reparto/dashboard.jpg','/screenshots/reparto/pedidos.jpg','/screenshots/reparto/camion.jpg','/screenshots/reparto/onboarding.jpg']}
    differentiators={['100% offline, sincroniza solo','Sin Play Store ni App Store','Parser de pedidos por WhatsApp','Ruta optimizada con IA','Precios por tipo de cliente','Multi-usuario con roles','Cuentas corrientes','Gestión de envases']}
    features={[
      { title: 'Dashboard del día', desc: 'Métricas en tiempo real: entregados vs pendientes, total cobrado, proyección de mañana. Alertas de stock bajo y saldos pendientes.' },
      { title: '100% offline', desc: 'Todos los datos se guardan en el dispositivo. Funciona en el campo sin señal y sincroniza automáticamente al volver a conectarse.' },
      { title: 'Parser de pedidos WhatsApp', desc: 'Pegás un mensaje de pedido de WhatsApp y la app lo convierte en un pedido automáticamente. Ahorrás minutos de carga por pedido.' },
      { title: 'Ruta con IA', desc: 'La app sugiere el orden óptimo de entregas para ahorrar tiempo y combustible. También podés ordenar las paradas manualmente.' },
      { title: 'Armar camión', desc: 'Consolidado automático de todos los productos a cargar antes de salir. Vista clara para preparar la carga del día.' },
      { title: 'Multi-usuario con roles', desc: 'Admin, vendedor y repartidor. Cada uno ve lo que necesita: el repartidor solo ve su ruta del día.' },
      { title: 'Cuentas corrientes', desc: 'Seguimiento de deuda por cliente, movimientos de cuenta y vista total de lo que debés cobrar.' },
      { title: 'Gestión de envases', desc: 'Registrá el retorno de bidones, botellones y otros envases. Sabés cuántos tiene cada cliente en todo momento.' },
      { title: 'WhatsApp masivo', desc: 'Avisale a todos los clientes del día con un mensaje personalizable — nombre, dirección, productos — con un solo toque.' },
    ]}
    plans={[
      { name: 'Básico', features: ['Hasta 25 clientes','Hasta 100 pedidos por mes','Gestión de pedidos y ruta','Catálogo con variantes','Control de stock','Dashboard del día'] },
      { name: 'Premium', highlight: true, badge: 'Más elegido', features: ['Hasta 50 clientes','Hasta 300 pedidos por mes','Todo lo del plan Básico','Cuentas corrientes','Parser de pedidos WhatsApp','Ruta optimizada con IA','Hasta 2 colaboradores'] },
      { name: 'Full', features: ['Clientes ilimitados','Pedidos ilimitados','Todo lo del plan Premium','Hasta 4 colaboradores','Funciones de IA avanzadas','Soporte prioritario'] },
    ]}
  />
</Layout>
