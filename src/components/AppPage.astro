---
interface Feature {
  title: string;
  desc: string;
}

interface Plan {
  name: string;
  highlight?: boolean;
  badge?: string;
  price?: string;
  features: string[];
}

interface Props {
  name: string;
  tagline: string;
  description: string;
  audience: string;
  screenshots: string[];
  accentColor: string;
  ctaUrl: string;
  features: Feature[];
  plans: Plan[];
  differentiators: string[];
}

const {
  name, tagline, description, audience,
  screenshots, accentColor, ctaUrl,
  features, plans, differentiators,
} = Astro.props;

const carouselId = `carousel-${name.replace(/\s/g, '-').toLowerCase()}`;
const hasScreenshots = screenshots.length > 0;
---

<!-- HERO -->
<section style="min-height:100vh; display:flex; align-items:center; padding:100px 48px 80px; position:relative; overflow:hidden;">
  <div style="position:absolute; inset:0; background:radial-gradient(ellipse 55% 55% at 75% 40%, oklch(20% 0.12 265 / 0.22) 0%, transparent 65%); pointer-events:none;"></div>
  <div style="position:absolute; inset:0; background-image:radial-gradient(oklch(28% 0.04 270 / 0.3) 1px, transparent 1px); background-size:28px 28px; pointer-events:none;"></div>

  <div style="max-width:1100px; margin:0 auto; width:100%;" class="hero-two-col">
    <!-- Text -->
    <div>
      <div style={`display:inline-flex; align-items:center; padding:6px 14px; border:1px solid ${accentColor}35; border-radius:100px; margin-bottom:18px; font-size:13px; color:${accentColor}; background:${accentColor}18; font-weight:500; letter-spacing:0.02em;`}>
        {audience}
      </div>
      <h1 class="font-syne" style="font-size:clamp(40px,5.5vw,72px); font-weight:800; line-height:1.04; letter-spacing:-0.032em; margin-bottom:12px; text-wrap:balance;">
        {name}
      </h1>
      <p style={`font-size:18px; font-weight:500; color:${accentColor}; margin-bottom:16px; line-height:1.5;`}>{tagline}</p>
      <p style="color:oklch(52% 0.04 270); font-size:16px; line-height:1.75; font-weight:300; margin-bottom:36px; max-width:480px;">{description}</p>
      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:16px;">
        <a href={ctaUrl} target="_blank"
          style={`display:inline-block; background:${accentColor}; color:#fff; padding:14px 28px; border-radius:10px; font-weight:600; font-size:15px; letter-spacing:0.01em; transition:opacity 0.2s;`}
          onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
          Probar 28 días gratis →
        </a>
        <a href="https://wa.me/542235767784" target="_blank"
          style="background:oklch(13% 0.04 270); border:1px solid oklch(22% 0.04 270); color:oklch(78% 0.02 270); padding:14px 24px; border-radius:10px; font-weight:500; font-size:15px; transition:border-color 0.2s;"
          onmouseover="this.style.borderColor='oklch(38% 0.04 270)'" onmouseout="this.style.borderColor='oklch(22% 0.04 270)'">
          Hablar por WhatsApp
        </a>
      </div>
      <p style="font-size:12px; color:oklch(36% 0.04 270); letter-spacing:0.02em;">Sin tarjeta de crédito · Hasta 28 días gratis</p>
    </div>

    <!-- Phone mockup -->
    <div class="hero-phone" style="display:flex; flex-direction:column; align-items:center; gap:14px;">
      {hasScreenshots ? (
        <>
          <div id={carouselId} style="width:260px; height:520px; border-radius:40px; border:2px solid oklch(20% 0.04 270); background:#060610; overflow:hidden; box-shadow:0 40px 80px oklch(0% 0 0 / 0.55), 0 0 0 1px oklch(100% 0 0 / 0.03); position:relative; flex-shrink:0;">
            <div style="position:absolute; top:14px; left:50%; transform:translateX(-50%); width:68px; height:4px; border-radius:2px; background:oklch(20% 0.04 270); z-index:10;"></div>
            <div style="overflow:hidden; height:100%;">
              <div data-track style="display:flex; transition:transform 0.65s cubic-bezier(0.22,1,0.36,1);">
                {screenshots.map((src, i) => (
                  <img src={src} alt={`${name} pantalla ${i+1}`} style="width:260px; height:520px; object-fit:cover; flex-shrink:0; display:block;" loading={i === 0 ? 'eager' : 'lazy'} />
                ))}
              </div>
            </div>
          </div>
          <div data-dots={carouselId} style="display:flex; gap:6px; align-items:center;">
            {screenshots.map((_, i) => (
              <button
                data-dot={i}
                style={`width:${i===0?'20px':'8px'}; height:8px; border-radius:4px; background:${i===0?accentColor:'oklch(22% 0.04 270)'}; transition:width 0.3s ease, background 0.3s ease; cursor:pointer; border:none; padding:0; flex-shrink:0;`}
                aria-label={`Pantalla ${i+1}`}
              />
            ))}
          </div>
        </>
      ) : (
        <div style="width:260px; height:520px; border-radius:40px; border:2px dashed oklch(20% 0.04 270); background:oklch(10% 0.02 270); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px;">
          <div style="font-size:48px; opacity:0.2;">📱</div>
          <p style="font-size:13px; color:oklch(34% 0.04 270); text-align:center; line-height:1.6; letter-spacing:0.02em;">Imágenes<br />próximamente</p>
        </div>
      )}
    </div>
  </div>
</section>

<!-- DIFFERENTIATORS STRIP -->
<section style="border-top:1px solid oklch(15% 0.03 270); border-bottom:1px solid oklch(15% 0.03 270); padding:28px 48px; background:#0b0b12;">
  <div style="max-width:1100px; margin:0 auto;" class="diff-grid">
    {differentiators.map(d => (
      <div style="display:flex; align-items:flex-start; gap:8px;">
        <span style={`color:${accentColor}; font-weight:700; font-size:13px; flex-shrink:0; margin-top:1px;`}>✓</span>
        <span style="font-size:13px; color:oklch(62% 0.03 270); line-height:1.45;">{d}</span>
      </div>
    ))}
  </div>
</section>

<!-- FEATURES -->
<section style="padding:96px 48px; background:#09090f;">
  <div style="max-width:1100px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:60px;">
      <p class="section-label" style={`color:${accentColor};`}>Funcionalidades</p>
      <h2 class="font-syne" style="font-size:clamp(28px,4vw,48px); font-weight:700; letter-spacing:-0.025em;">Todo lo que necesitás</h2>
    </div>
    <div class="feature-grid">
      {features.map((f, i) => (
        <div class="feature-cell">
          <div class="font-syne" style={`font-size:12px; font-weight:700; color:${accentColor}; letter-spacing:0.06em; margin-bottom:12px;`}>
            {String(i+1).padStart(2,'0')}
          </div>
          <h3 class="font-syne" style="font-size:17px; font-weight:700; margin-bottom:8px; letter-spacing:-0.01em; color:oklch(92% 0.01 270);">{f.title}</h3>
          <p style="color:oklch(50% 0.04 270); font-size:13px; line-height:1.7; font-weight:300;">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PLANS -->
<section style="padding:96px 48px; background:#0c0c14;">
  <div style="max-width:1000px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:60px;">
      <p class="section-label" style={`color:${accentColor};`}>Precios</p>
      <h2 class="font-syne" style="font-size:clamp(28px,4vw,48px); font-weight:700; letter-spacing:-0.025em; margin-bottom:12px;">Planes</h2>
      <p style="color:oklch(50% 0.04 270); font-weight:300;">Comenzá con el plan Profesional gratis por 28 días.</p>
    </div>
    <div class="plans-grid">
      {plans.map(plan => (
        <div style={`position:relative; background:#111119; border-radius:14px; padding:28px 22px; border:${plan.highlight ? `2px solid ${accentColor}55` : '1px solid oklch(18% 0.04 270)'};`}>
          {plan.badge && (
            <div style={`position:absolute; top:-12px; left:50%; transform:translateX(-50%); font-size:11px; font-weight:700; padding:3px 12px; border-radius:100px; background:${accentColor}; color:#fff; white-space:nowrap; letter-spacing:0.04em;`}>
              {plan.badge}
            </div>
          )}
          <h3 class="font-syne" style="font-size:21px; font-weight:700; margin-bottom:4px;">{plan.name}</h3>
          {plan.price && (
            <p style={`font-size:18px; font-weight:700; color:${plan.highlight ? accentColor : 'oklch(78% 0.02 270)'}; margin-bottom:2px;`}>{plan.price}</p>
          )}
          {plan.highlight
            ? <p style={`font-size:13px; font-weight:600; color:${accentColor}; margin-bottom:16px;`}>28 días gratis, sin tarjeta</p>
            : <p style="font-size:13px; color:oklch(40% 0.04 270); margin-bottom:16px;">Consultá precio</p>
          }
          <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:20px;">
            {plan.features.map(feat => (
              <div style="display:flex; align-items:flex-start; gap:8px; font-size:13px; color:oklch(58% 0.03 270); line-height:1.45;">
                <span style={`color:${accentColor}; font-weight:700; font-size:12px; flex-shrink:0; margin-top:2px;`}>✓</span>
                {feat}
              </div>
            ))}
          </div>
          {plan.highlight
            ? (
              <a href={ctaUrl} target="_blank"
                style={`display:block; text-align:center; font-weight:600; padding:13px; border-radius:9px; background:${accentColor}; color:#fff; font-size:14px; transition:opacity 0.2s;`}
                onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
                Empezar gratis ahora →
              </a>
            ) : (
              <a href="https://wa.me/542235767784" target="_blank"
                style="display:block; text-align:center; font-weight:500; padding:12px; border-radius:9px; border:1px solid oklch(24% 0.04 270); color:oklch(58% 0.03 270); font-size:14px; transition:border-color 0.2s;"
                onmouseover="this.style.borderColor='oklch(40% 0.04 270)'" onmouseout="this.style.borderColor='oklch(24% 0.04 270)'">
                Consultar por WhatsApp
              </a>
            )
          }
        </div>
      ))}
    </div>
    <p style="text-align:center; color:oklch(36% 0.04 270); font-size:13px; margin-top:28px;">
      ¿No sabés qué plan necesitás?
      <a href="https://wa.me/542235767784" target="_blank" style="color:oklch(50% 0.04 270); transition:color 0.2s;" onmouseover="this.style.color='oklch(80% 0.02 270)'" onmouseout="this.style.color='oklch(50% 0.04 270)'"> Escribinos</a>
    </p>
  </div>
</section>

<!-- CTA FINAL -->
<section style="padding:96px 48px; background:#09090f; text-align:center; position:relative; overflow:hidden;">
  <div style="position:absolute; inset:0; background:radial-gradient(ellipse 60% 60% at 50% 50%, oklch(18% 0.10 265 / 0.32) 0%, transparent 70%); pointer-events:none;"></div>
  <div style="position:relative; max-width:580px; margin:0 auto;">
    <h2 class="font-syne" style="font-size:clamp(28px,4vw,48px); font-weight:800; letter-spacing:-0.03em; margin-bottom:14px; line-height:1.1;">Empezá hoy, sin compromisos</h2>
    <p style="color:oklch(50% 0.04 270); font-size:16px; font-weight:300; margin-bottom:36px; line-height:1.75;">
      28 días gratis con el plan Profesional completo.<br />Sin tarjeta, sin instalación.
    </p>
    <a href={ctaUrl} target="_blank"
      style={`display:inline-block; background:${accentColor}; color:#fff; padding:15px 32px; border-radius:10px; font-weight:600; font-size:15px; transition:opacity 0.2s;`}
      onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
      Probar gratis ahora →
    </a>
  </div>
</section>

<script define:vars={{ carouselId, accentColor }}>
  const wrap = document.getElementById(carouselId);
  if (wrap) {
    const track = wrap.querySelector('[data-track]');
    const dotsWrap = document.querySelector(`[data-dots="${carouselId}"]`);
    const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll('[data-dot]')) : [];
    const total = track ? track.children.length : 0;
    let current = 0;

    function goTo(n) {
      current = (n + total) % total;
      track.style.transform = `translateX(-${current * 260}px)`;
      dots.forEach((d, i) => {
        d.style.width = i === current ? '20px' : '8px';
        d.style.background = i === current ? accentColor : 'oklch(22% 0.04 270)';
      });
    }

    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
    if (total > 1) setInterval(() => goTo(current + 1), 2800);
  }
</script>
