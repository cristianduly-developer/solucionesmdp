---
interface Feature {
  icon?: string;
  title: string;
  desc: string;
}

interface Plan {
  name: string;
  highlight?: boolean;
  badge?: string;
  price?: string;
  features: string[];
}

interface Props {
  name: string;
  tagline: string;
  description: string;
  audience: string;
  screenshots: string[];
  accentColor?: string;
  accentBg?: string;
  accentBorder?: string;
  accentText?: string;
  ctaUrl?: string;
  features: Feature[];
  plans?: Plan[];
  differentiators: string[];
  icon?: string;
}

const {
  name, tagline, description, audience,
  screenshots, features, differentiators,
} = Astro.props;

const waMsg = encodeURIComponent(`Hola! Me interesa ver una demo de ${name}. ¿Podemos coordinar?`);
const waUrl = `https://wa.me/542236965481?text=${waMsg}`;
const hasScreenshots = screenshots.length > 0;
const carouselId = `carousel-${name.replace(/\s/g, '-').toLowerCase()}`;
---

<!-- ═══ HERO ═══ -->
<section class="hero-glow dot-grid relative min-h-[85vh] flex items-center">
  <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-28 md:py-36 w-full">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">

      <!-- Text -->
      <div>
        <a href="/" class="anim-1 inline-flex items-center gap-1.5 text-[13px] mb-6 transition-colors" style="color: var(--text-faint);">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
          Volver al portfolio
        </a>

        <div class="anim-2 mb-4">
          <span class="chip">{audience}</span>
        </div>

        <h1 class="anim-3 headline text-[clamp(36px,5.5vw,56px)] mb-4">{name}</h1>

        <p class="anim-4 text-[17px] font-medium mb-3" style="color: var(--accent);">{tagline}</p>

        <p class="anim-5 text-[15px] leading-relaxed mb-8 max-w-md" style="color: var(--text-muted);">{description}</p>

        <div class="anim-5 flex flex-col sm:flex-row gap-3 mb-8">
          <a href={waUrl} target="_blank" class="btn-primary py-2.5 px-6">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Solicitar demo
          </a>
          <a href="https://wa.me/542236965481" target="_blank" class="btn-ghost py-2.5 px-6">
            Hablar por WhatsApp
          </a>
        </div>
      </div>

      <!-- Phone mockup -->
      <div class="flex flex-col items-center gap-4">
        {hasScreenshots ? (
          <>
            <div id={carouselId} class="relative w-[260px] h-[520px] flex-shrink-0 overflow-hidden" style="border-radius: 36px; border: 2px solid var(--border-hover); background: var(--bg);">
              <div class="absolute top-3.5 left-1/2 -translate-x-1/2 w-16 h-1 rounded-full z-10" style="background: var(--border-hover);"></div>
              <div class="overflow-hidden h-full">
                <div data-track class="flex transition-transform duration-700" style="transition-timing-function: cubic-bezier(0.22,1,0.36,1);">
                  {screenshots.map((src, i) => (
                    <img src={src} alt={`${name} pantalla ${i+1}`} class="w-[260px] h-[520px] object-cover flex-shrink-0 block" loading={i === 0 ? 'eager' : 'lazy'} />
                  ))}
                </div>
              </div>
            </div>
            {screenshots.length > 1 && (
              <div data-dots={carouselId} class="flex gap-1.5 items-center">
                {screenshots.map((_, i) => (
                  <button
                    data-dot={i}
                    class="h-2 rounded-full border-none p-0 flex-shrink-0 cursor-pointer transition-all duration-300"
                    style={`width: ${i === 0 ? '20px' : '8px'}; background: ${i === 0 ? 'var(--accent)' : 'var(--border-hover)'};`}
                    aria-label={`Pantalla ${i+1}`}
                  />
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="w-[260px] h-[520px] flex flex-col items-center justify-center gap-3" style="border-radius: 36px; border: 2px dashed var(--border-hover); background: var(--bg-surface);">
            <span class="text-5xl opacity-20">📱</span>
            <p class="text-[13px] text-center leading-relaxed" style="color: var(--text-faint);">Imágenes<br/>próximamente</p>
          </div>
        )}
      </div>
    </div>
  </div>
</section>


<!-- ═══ DIFERENCIADORES ═══ -->
<div class="section-alt">
  <div class="max-w-[1200px] mx-auto px-6 py-6">
    <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center md:justify-start">
      {differentiators.map(d => (
        <div class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5 flex-shrink-0" style="color: var(--accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          <span class="text-[13px]" style="color: var(--text-muted);">{d}</span>
        </div>
      ))}
    </div>
  </div>
</div>


<!-- ═══ SCREENSHOTS GALLERY ═══ -->
{hasScreenshots && screenshots.length > 1 && (
  <section class="max-w-[1200px] mx-auto px-6 py-20 md:py-24">
    <div class="reveal mb-10">
      <p class="text-[12px] font-semibold tracking-widest uppercase mb-3" style="color: var(--accent);">Capturas</p>
      <h2 class="headline text-[clamp(24px,3.5vw,36px)]">Así se ve por dentro</h2>
    </div>
    <div class="reveal grid grid-cols-2 md:grid-cols-4 gap-3">
      {screenshots.map((src, i) => (
        <div class="card overflow-hidden">
          <img src={src} alt={`${name} captura ${i+1}`} class="w-full aspect-[9/16] object-cover opacity-90 hover:opacity-100 transition-opacity duration-300" loading="lazy" />
        </div>
      ))}
    </div>
  </section>
)}


<!-- ═══ FUNCIONALIDADES ═══ -->
<section class={hasScreenshots && screenshots.length > 1 ? 'section-alt' : ''}>
  <div class="max-w-[1200px] mx-auto px-6 py-20 md:py-24">
    <div class="reveal mb-14">
      <p class="text-[12px] font-semibold tracking-widest uppercase mb-3" style="color: var(--accent);">Funcionalidades</p>
      <h2 class="headline text-[clamp(24px,3.5vw,36px)] mb-3">Todo lo que incluye</h2>
      <p class="text-[15px] max-w-lg" style="color: var(--text-muted);">Diseñado específicamente para este rubro. Sin módulos genéricos.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map((f, i) => (
        <div class={`reveal reveal-d${(i % 6)+1} card p-6`}>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-[13px] font-semibold font-mono" style="color: var(--accent);">{String(i+1).padStart(2,'0')}</span>
            <h3 class="text-[15px] font-semibold" style="color: var(--text);">{f.title}</h3>
          </div>
          <p class="text-[13px] leading-relaxed" style="color: var(--text-muted);">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>


<!-- ═══ CTA FINAL ═══ -->
<section class="relative overflow-hidden">
  <div class="hero-glow">
    <div class="relative z-10 max-w-3xl mx-auto px-6 py-20 md:py-28 text-center">
      <div class="reveal">
        <h2 class="headline text-[clamp(24px,4vw,40px)] mb-4">
          ¿Te interesa {name.toLowerCase().startsWith('app') ? name : `la ${name}`}?
        </h2>
        <p class="text-[15px] max-w-md mx-auto mb-8" style="color: var(--text-muted);">
          Coordinamos una demo personalizada para mostrarte cómo funciona con tu negocio. Sin compromiso.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={waUrl} target="_blank" class="btn-primary py-3 px-7">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Solicitar demo por WhatsApp
          </a>
          <a href="/" class="btn-ghost py-3 px-7">
            Ver más proyectos
          </a>
        </div>
      </div>
    </div>
  </div>
</section>


<script define:vars={{ carouselId }}>
  const wrap = document.getElementById(carouselId);
  if (wrap) {
    const track = wrap.querySelector('[data-track]');
    const dotsWrap = document.querySelector(`[data-dots="${carouselId}"]`);
    const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll('[data-dot]')) : [];
    const total = track ? track.children.length : 0;
    let current = 0;

    function goTo(n) {
      current = (n + total) % total;
      track.style.transform = `translateX(-${current * 260}px)`;
      dots.forEach((d, i) => {
        d.style.width = i === current ? '20px' : '8px';
        d.style.background = i === current ? 'var(--accent)' : 'var(--border-hover)';
      });
    }

    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
    if (total > 1) setInterval(() => goTo(current + 1), 3200);
  }
</script>
